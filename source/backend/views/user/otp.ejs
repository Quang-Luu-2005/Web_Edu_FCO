<style>
  .auth-page {
    min-height: calc(100vh - 120px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
  }

  .auth-card {
    width: 100%;
    max-width: 420px;
    background: #ffffff;
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(15,23,42,0.10);
    padding: 40px 40px 32px;
    text-align: center;
  }

  .otp-title {
    font-family: 'Be Vietnam Pro', 'Segoe UI', Arial, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #111827;
    margin: 0 0 8px;
  }

  .otp-subtitle {
    font-size: 14px;
    color: #6b7280;
    margin: 0 0 28px;
    line-height: 1.6;
  }

  /* Đếm ngược */
  .otp-timer {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #2563eb;
    margin-bottom: 24px;
  }

  .otp-timer.warning { color: #dc2626; }

  /* 6 ô nhập OTP */
  .otp-inputs {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .otp-box {
    width: 48px;
    height: 56px;
    border: 2px solid #d1d5db;
    border-radius: 10px;
    font-size: 24px;
    font-weight: 700;
    text-align: center;
    color: #111827;
    background: #f9fafb;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    caret-color: transparent;
  }

  .otp-box:focus {
    border-color: #2563eb;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(37,99,235,0.12);
  }

  .otp-box.filled {
    border-color: #16a34a;
    background: #f0fdf4;
  }

  .otp-submit {
    width: 100%;
    height: 46px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s;
  }

  .otp-submit:hover { background: #1d4ed8; }
  .otp-submit:disabled { background: #93c5fd; cursor: default; }

  .otp-back {
    display: block;
    margin-top: 16px;
    font-size: 14px;
    color: #6b7280;
    text-decoration: none;
  }

  .otp-back a { color: #2563eb; font-weight: 600; text-decoration: none; }
  .otp-back a:hover { text-decoration: underline; }
</style>

<div class="auth-page">
  <div class="auth-card">
    <h1 class="otp-title">Nhập mã xác nhận</h1>
    <p class="otp-subtitle">
      Mã 6 số đã được gửi đến email của bạn.<br>
      Mã có hiệu lực trong <strong>2 phút</strong>.
    </p>

    <%- include('../partials/messages') %>

    <% if (typeof expired !== 'undefined' && expired) { %>
      <p style="margin-top:16px"><a href="/users/register" style="color:#2563eb;font-weight:600">← Đăng ký lại</a></p>
    <% } else { %>

    <!-- Đếm ngược -->
    <div class="otp-timer" id="otp-timer">
      <i class="fas fa-clock"></i>
      <span id="timer-text">2:00</span>
    </div>

    <form action="/users/otp" method="POST" id="otp-form">
      <div class="otp-inputs" id="otp-inputs">
        <input class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" />
        <input class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" />
        <input class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" />
        <input class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" />
        <input class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" />
        <input class="otp-box" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" />
      </div>
      <input type="hidden" name="otpNumber" id="otpNumber" />
      <button type="submit" class="otp-submit" id="otp-submit" disabled>Xác nhận</button>
    </form>

    <span class="otp-back">Không nhận được mail?
      <a href="/users/register">Đăng ký lại</a>
    </span>

    <% } %>
  </div>
</div>

<script>
  const boxes   = document.querySelectorAll('.otp-box');
  const hidden  = document.getElementById('otpNumber');
  const submit  = document.getElementById('otp-submit');
  const timerEl = document.getElementById('timer-text');
  const timerWrap = document.getElementById('otp-timer');

  // ── Điều hướng giữa các ô ──
  boxes.forEach((box, i) => {
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace') {
        box.value = '';
        box.classList.remove('filled');
        if (i > 0) boxes[i - 1].focus();
        syncHidden();
        e.preventDefault();
      } else if (e.key === 'ArrowLeft' && i > 0) {
        boxes[i - 1].focus();
      } else if (e.key === 'ArrowRight' && i < boxes.length - 1) {
        boxes[i + 1].focus();
      }
    });

    box.addEventListener('input', () => {
      // Chỉ cho nhập số
      box.value = box.value.replace(/\D/g, '').slice(-1);
      box.classList.toggle('filled', box.value !== '');
      if (box.value && i < boxes.length - 1) boxes[i + 1].focus();
      syncHidden();
    });

    // Paste toàn bộ mã
    box.addEventListener('paste', (e) => {
      const text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
      if (text.length === 6) {
        boxes.forEach((b, idx) => {
          b.value = text[idx] || '';
          b.classList.toggle('filled', b.value !== '');
        });
        boxes[5].focus();
        syncHidden();
      }
      e.preventDefault();
    });
  });

  function syncHidden() {
    const val = Array.from(boxes).map(b => b.value).join('');
    hidden.value = val;
    submit.disabled = val.length < 6;
  }

  // ── Đếm ngược 2 phút ──
  let seconds = 120;
  const interval = setInterval(() => {
    seconds--;
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    timerEl.textContent = `${m}:${s.toString().padStart(2, '0')}`;
    if (seconds <= 30) timerWrap.classList.add('warning');
    if (seconds <= 0) {
      clearInterval(interval);
      timerEl.textContent = 'Hết hạn';
      submit.disabled = true;
      boxes.forEach(b => { b.disabled = true; b.style.opacity = '0.5'; });
      // Tự submit form rỗng để server xóa user và báo hết hạn
      hidden.value = 'EXPIRED';
      document.getElementById('otp-form').submit();
    }
  }, 1000);

  // Focus ô đầu tiên
  if (boxes[0]) boxes[0].focus();
</script>

                </button>
                <button type="button" class="reaction-btn faq-react-btn <%= thread.currentUserReaction === 'haha' ? 'selected' : '' %>" data-target="<%= thread.id %>" data-reaction="haha">
                  <i class="far fa-laugh"></i> Haha
                </button>
                <button type="button" class="reaction-btn faq-react-btn <%= thread.currentUserReaction === 'wow' ? 'selected' : '' %>" data-target="<%= thread.id %>" data-reaction="wow">

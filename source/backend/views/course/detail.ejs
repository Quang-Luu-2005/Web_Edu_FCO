                  <% if (isAdmin) { %>
                  <button type="button" class="btn btn-link p-0 faq-delete-btn" data-target="<%= reply.id %>" data-parent="<%= thread.id %>">
                    Xóa
                  </button>
                  <% } %>
                </div>
                <% if (isPaid || isAdmin) { %>
                <div class="reaction-row">
                  <button type="button" class="reaction-btn faq-react-btn <%= reply.currentUserReaction === 'like' ? 'selected' : '' %>" data-target="<%= reply.id %>" data-parent="<%= thread.id %>" data-reaction="like">
                    <i class="far fa-thumbs-up"></i> Thích
                  </button>
                  <button type="button" class="reaction-btn faq-react-btn <%= reply.currentUserReaction === 'love' ? 'selected' : '' %>" data-target="<%= reply.id %>" data-parent="<%= thread.id %>" data-reaction="love">
                    <i class="fas fa-heart"></i> Yêu thích
                  </button>
                  <button type="button" class="reaction-btn faq-react-btn <%= reply.currentUserReaction === 'haha' ? 'selected' : '' %>" data-target="<%= reply.id %>" data-parent="<%= thread.id %>" data-reaction="haha">
                    <i class="far fa-laugh"></i> Haha
                  </button>
                </div>
                <% } %>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Bấm nút comment -->
  <script type="text/javascript">
  $(document).ready(() => {
    const courseName = encodeURIComponent($("#nameCourse").attr("data-name"));

    const showPanel = (panelId) => {
      $(".course-tab").removeClass("active");
      $(".course-panel").removeClass("active");
      $(`.course-tab[data-target='${panelId}']`).addClass("active");
      $(`#${panelId}`).addClass("active");
    };

    $(".course-tab").on("click", function () {
      const target = $(this).attr("data-target");
      if (target) {
        showPanel(target);
      }
    });

    showPanel("couser-intro");

    $("#faq-post-btn").on("click", () => {
      const review = $("#faq-review").val().trim();
      if (review === "") {
        return;
      }
      $.post(`/course/${courseName}/review`, { review }, () => window.location.reload());
    });

    $(document).on("click", ".faq-reply-toggle", function () {
      const target = $(this).attr("data-target");
      $(`#reply-box-${target}`).toggleClass("active");
    });

    $(document).on("click", ".faq-reply-submit", function () {
      const reviewId = $(this).attr("data-review-id");
      const reply = $(`.faq-reply-input[data-review-id='${reviewId}']`).val().trim();
      if (reply === "") {
        return;
      }
      $.post(`/course/${courseName}/review/${reviewId}/reply`, { reply }, () => window.location.reload());
    });

    $(document).on("click", ".faq-react-btn", function () {
      const reactionType = $(this).attr("data-reaction");
      const targetId = $(this).attr("data-target");
      const parentId = $(this).attr("data-parent");
      const reviewId = parentId || targetId;
      const payload = parentId ? { targetId, reactionType } : { reactionType };
      $.post(`/course/${courseName}/review/${reviewId}/react`, payload, () => window.location.reload());
    });

    $(document).on("click", ".faq-report-btn", function () {
      const targetId = $(this).attr("data-target");
      const parentId = $(this).attr("data-parent");
      const reviewId = parentId || targetId;
      const reason = prompt("Lý do báo cáo");
      if (reason === null) {
        return;
      }
      const payload = parentId ? { targetId, reason } : { reason };
      $.post(`/course/${courseName}/review/${reviewId}/report`, payload, () => window.location.reload());
    });

    $(document).on("click", ".faq-delete-btn", function () {
      const targetId = $(this).attr("data-target");
      const parentId = $(this).attr("data-parent");
      const reviewId = parentId || targetId;
      if (!confirm("Xóa nội dung này?")) {
        return;
      }
      const payload = parentId ? { targetId } : {};
      $.post(`/course/${courseName}/review/${reviewId}/delete`, payload, () => window.location.reload());
    });
  });
  </script>

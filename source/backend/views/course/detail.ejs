  <script type="text/javascript">
  $(document).ready(() => {
    const courseName = encodeURIComponent($("#nameCourse").attr("data-name"));

    const showPanel = (panelId) => {
      $(".course-tab").removeClass("active");
      $(".course-panel").removeClass("active");
      $(`.course-tab[data-target='${panelId}']`).addClass("active");
      $(`#${panelId}`).addClass("active");
    };

    $(".course-tab").on("click", function () {
      const target = $(this).attr("data-target");
      if (target) {
        showPanel(target);
      }
    });

    showPanel("couser-intro");

    $("#faq-post-btn").on("click", () => {
      const review = $("#faq-review").val().trim();
      if (review === "") {
        return;
      }
      $.post(`/course/${courseName}/review`, { review }, () => {
        $('#faq-review').val('');
        // Thêm comment mới vào DOM không reload
        location.reload();
      });
    });

    $(document).on("click", ".faq-reply-toggle", function () {
      const target = $(this).attr("data-target");
      $(`#reply-box-${target}`).toggleClass("active");
    });

    $(document).on("click", ".faq-reply-submit", function () {
      const reviewId = $(this).attr("data-review-id");
      const reply = $(`.faq-reply-input[data-review-id='${reviewId}']`).val().trim();
      if (reply === "") {
        return;
      }
      $.post(`/course/${courseName}/review/${reviewId}/reply`, { reply }, () => {
        $(`.faq-reply-input[data-review-id='${reviewId}']`).val('');
        $(`#reply-box-${reviewId}`).removeClass('active');
        location.reload();
      });
    });

    $(document).on("click", ".faq-react-btn", function () {
      const reactionType = $(this).attr("data-reaction");
      const targetId = $(this).attr("data-target");
      const parentId = $(this).attr("data-parent");
      const reviewId = parentId || targetId;
      const payload = parentId ? { targetId, reactionType } : { reactionType };
      const $btn = $(this);
      $.post(`/course/${courseName}/review/${reviewId}/react`, payload, () => {
        // Toggle selected state
        const wasSelected = $btn.hasClass('selected');
        $btn.toggleClass('selected');
        // Cập nhật số lượt thích
        const countId = '#like-count-' + (targetId);
        const $count = $(countId);
        if ($count.length) {
          const cur = parseInt($count.text()) || 0;
          const next = wasSelected ? Math.max(0, cur - 1) : cur + 1;
          $count.text(next + ' lượt thích');
        }
        // Cập nhật badge trong nút
        const $badge = $btn.find('.reaction-count');
        if (wasSelected) {
          $badge.remove();
        } else {
          if (!$badge.length) $btn.append('<span class="reaction-count">1</span>');
          else $badge.text(parseInt($badge.text()) + 1);
        }
      });
    });

    $(document).on("click", ".faq-report-btn", function () {
      const targetId = $(this).attr("data-target");
      const parentId = $(this).attr("data-parent");
      // Mở popup báo cáo
      $('#report-modal').data({ targetId, parentId }).fadeIn(150);
      $('#report-reason').val('').focus();
    });

    $(document).on("click", ".faq-delete-btn", function () {
      const targetId = $(this).attr("data-target");
      const parentId = $(this).attr("data-parent");
      const reviewId = parentId || targetId;
      if (!confirm("Xóa nội dung này?")) return;
      const payload = parentId ? { targetId } : {};
      $.post(`/course/${courseName}/review/${reviewId}/delete`, payload, () => {
        // Xóa DOM element không reload
        if (parentId) {
          $(`[data-reply-id="${targetId}"]`).fadeOut(300, function() { $(this).remove(); });
        } else {
          $(`[data-thread-id="${targetId}"]`).fadeOut(300, function() { $(this).remove(); });
        }
      });
    });
  });
  </script>

  <!-- Popup báo cáo -->
  <div id="report-modal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;display:none">
    <div style="background:#fff;border-radius:12px;padding:28px;width:100%;max-width:400px;box-shadow:0 16px 40px rgba(0,0,0,0.2);margin:auto;position:relative;top:50%;transform:translateY(-50%)">
      <h3 style="font-size:16px;font-weight:700;color:#1a1f2e;margin:0 0 8px">Báo cáo nội dung</h3>
      <p style="font-size:13px;color:#718096;margin:0 0 16px">Vui lòng cho biết lý do báo cáo nội dung này.</p>
      <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px">
        <% ['Nội dung không phù hợp','Spam','Thông tin sai lệch','Ngôn ngữ thô tục','Khác'].forEach(r => { %>
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:8px 12px;border-radius:8px;border:1px solid #e8e8e4;font-size:13px;color:#374151">
          <input type="radio" name="report-reason-opt" value="<%= r %>" style="accent-color:#3b6fd4" onchange="document.getElementById('report-reason').value=this.value" />
          <%= r %>
        </label>
        <% }) %>
        <input type="text" id="report-reason" placeholder="Hoặc nhập lý do khác..." style="height:38px;padding:0 12px;border:1px solid #e8e8e4;border-radius:8px;font-size:13px;color:#1a1f2e;outline:none;margin-top:4px" />
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button onclick="$('#report-modal').hide()" style="height:36px;padding:0 16px;background:transparent;border:1px solid #e8e8e4;border-radius:8px;font-size:13px;cursor:pointer;color:#718096">Huỷ</button>
        <button onclick="submitReport()" style="height:36px;padding:0 16px;background:#dc2626;border:none;border-radius:8px;font-size:13px;font-weight:600;color:#fff;cursor:pointer">Gửi báo cáo</button>
      </div>
    </div>
  </div>

  <script>
  function submitReport() {
    const reason = $('#report-reason').val().trim();
    if (!reason) { alert('Vui lòng nhập lý do'); return; }
    const { targetId, parentId } = $('#report-modal').data();
    const reviewId = parentId || targetId;
    const courseName = encodeURIComponent($("#nameCourse").attr("data-name"));
    const payload = parentId ? { targetId, reason } : { reason };
    $.post(`/course/${courseName}/review/${reviewId}/report`, payload, () => {
      $('#report-modal').hide();
      alert('Đã gửi báo cáo. Cảm ơn bạn!');
    });
  }
  // Đóng khi click ngoài
  $('#report-modal').on('click', function(e) {
    if (e.target === this) $(this).hide();
  });
  </script>

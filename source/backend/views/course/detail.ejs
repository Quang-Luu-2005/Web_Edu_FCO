            <img src="<%= thread.author.avatar %>" alt="<%= thread.author.name %>" class="faq-avatar" />
            <div class="faq-body">
              <div class="faq-head">
                <strong><%= thread.author.name %></strong>
                <span><%= thread.date ? thread.date.toDateString() : '' %></span>
              </div>
              <p><%= thread.text %></p>
              <div class="faq-stats">
                <span><%= thread.reactionSummary.total %> bày tỏ</span>
                <span><%= thread.replyCount %> trả lời</span>

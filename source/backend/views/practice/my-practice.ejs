<style>
.mp-page { min-height:calc(100vh - 120px); background:#f8f7f4; padding:40px 0 64px; }
.mp-wrap { width:85%; max-width:1000px; margin:0 auto; }
.mp-back { display:inline-flex; align-items:center; gap:6px; color:#3b6fd4; text-decoration:none; font-size:13px; margin-bottom:14px; }
.mp-back:hover { text-decoration:underline; }
.mp-title { font-size:24px; font-weight:700; color:#1a1f2e; margin-bottom:6px; }
.mp-sub { font-size:14px; color:#9ca3af; margin-bottom:24px; }

.mp-class-link { color:#3b6fd4; text-decoration:none; font-weight:600; }
.mp-class-link:hover { text-decoration:underline; color:#1e40af; }

.mp-more-btn { background:#fff; color:#3b6fd4; padding:8px 14px; border-radius:8px; font-size:12px; font-weight:700; text-decoration:none; white-space:nowrap; text-align:center; border:1.5px solid #3b6fd4; cursor:pointer; font-family:inherit; transition:all 0.15s; display:inline-flex; align-items:center; gap:5px; }
.mp-more-btn:hover { background:#eff6ff; color:#1e40af; border-color:#1e40af; }

/* Top "Lớp đang tham gia" section */
.mp-classes { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:14px; margin-bottom:22px; }
.mp-class-card { background:#fff; border:1px solid #e8e8e4; border-radius:12px; padding:14px; display:flex; gap:12px; align-items:center; text-decoration:none; color:inherit; transition:all 0.15s; }
.mp-class-card:hover { border-color:#3b6fd4; box-shadow:0 4px 14px rgba(59,111,212,0.10); transform:translateY(-1px); color:inherit; }
.mp-class-poster { width:56px; height:56px; border-radius:8px; object-fit:cover; flex:0 0 auto; background:#e8e8e4; }
.mp-class-info { flex:1; min-width:0; }
.mp-class-name { font-size:13.5px; font-weight:700; color:#1a1f2e; margin-bottom:3px; line-height:1.3; }
.mp-class-stats { font-size:11.5px; color:#718096; display:flex; gap:8px; flex-wrap:wrap; }
.mp-class-stats .ok { color:#15803d; font-weight:700; }
.mp-class-stats .pending { color:#d97706; font-weight:700; }
.mp-class-arrow { color:#cbd5e1; font-size:14px; flex:0 0 auto; }
.mp-class-card:hover .mp-class-arrow { color:#3b6fd4; }

.mp-section-head { display:flex; align-items:center; justify-content:space-between; margin:0 0 12px; }
.mp-section-head h2 { font-size:16px; font-weight:700; color:#1a1f2e; margin:0; }
.mp-section-head .all-link { font-size:13px; color:#3b6fd4; text-decoration:none; }
.mp-section-head .all-link:hover { text-decoration:underline; }

.mp-tabs { display:flex; gap:6px; margin-bottom:18px; border-bottom:1px solid #e8e8e4; flex-wrap:wrap; }
.mp-tab { padding:10px 18px; font-size:13px; font-weight:600; color:#9ca3af; cursor:pointer; border-bottom:2px solid transparent; background:none; border-left:none; border-right:none; border-top:none; font-family:inherit; }
.mp-tab.active { color:#3b6fd4; border-bottom-color:#3b6fd4; }
.mp-tab .count { background:#f1f5f9; color:#475569; padding:1px 7px; border-radius:10px; font-size:11px; margin-left:4px; }
.mp-tab.active .count { background:#dbeafe; color:#1e40af; }

.mp-card { background:#fff; border:1px solid #e8e8e4; border-radius:14px; overflow:hidden; box-shadow:0 2px 8px rgba(26,31,46,0.05); margin-bottom:14px; }
.mp-card-inner { display:flex; gap:0; align-items:stretch; }
.mp-poster { width:140px; min-height:120px; object-fit:cover; flex:0 0 140px; background:#e8e8e4; }
.mp-body { flex:1; padding:14px 20px; min-width:0; }
.mp-name { font-size:15px; font-weight:700; color:#1a1f2e; margin-bottom:3px; }
.mp-class { font-size:12.5px; color:#9ca3af; margin-bottom:8px; }
.mp-meta { display:flex; gap:14px; flex-wrap:wrap; font-size:12.5px; color:#718096; margin-bottom:8px; }
.mp-meta i { color:#9ca3af; }

.mp-badge { display:inline-flex; align-items:center; gap:5px; padding:4px 11px; border-radius:14px; font-size:11.5px; font-weight:700; }
.mp-badge-requested { background:#fef3c7; color:#92400e; }
.mp-badge-approved  { background:#dbeafe; color:#1e40af; }
.mp-badge-paid      { background:#dcfce7; color:#15803d; }
.mp-badge-free      { background:#fde68a; color:#92400e; }
.mp-badge-rejected  { background:#fef2f2; color:#dc2626; }
.mp-badge-pending   { background:#e2e8f0; color:#475569; }
.mp-badge-done      { background:#e2e8f0; color:#475569; }
.mp-badge-cancelled { background:#fef2f2; color:#dc2626; }

.mp-cta { padding:14px 18px; flex:0 0 auto; border-left:1px solid #f1f5f9; display:flex; flex-direction:column; gap:6px; justify-content:center; }
.mp-meet-btn { background:#3b6fd4; color:#fff; padding:9px 16px; border-radius:8px; font-size:12.5px; font-weight:700; text-decoration:none; white-space:nowrap; text-align:center; border:none; cursor:pointer; font-family:inherit; }
.mp-meet-btn:hover { background:#2c54a8; color:#fff; }
.mp-pay-btn { background:#16a34a; color:#fff; padding:9px 16px; border-radius:8px; font-size:12.5px; font-weight:700; white-space:nowrap; text-align:center; border:none; cursor:pointer; font-family:inherit; }
.mp-pay-btn:hover { background:#15803d; }
.mp-cancel-btn { background:transparent; color:#dc2626; padding:6px 14px; border-radius:8px; font-size:11.5px; font-weight:600; white-space:nowrap; text-align:center; border:1px solid #fecaca; cursor:pointer; font-family:inherit; }
.mp-cancel-btn:hover { background:#fef2f2; }

.mp-snapshot { font-size:11px; color:#6b7280; padding:8px 12px; background:#fafaf8; border-radius:8px; margin-top:8px; display:flex; gap:14px; flex-wrap:wrap; }
.mp-snapshot strong { color:#1a1f2e; }

.mp-empty { background:#fff; border:1px solid #e8e8e4; border-radius:14px; text-align:center; padding:48px 24px; color:#9ca3af; }
.mp-empty-big { padding:64px 24px; }

.mp-reject-msg { font-size:12px; color:#dc2626; padding:8px 12px; background:#fef2f2; border-radius:8px; margin-top:8px; border-left:3px solid #dc2626; }

.mp-zalo { font-size:12.5px; padding:9px 12px; background:#eff6ff; border-radius:8px; margin-top:8px; border-left:3px solid #3b6fd4; display:flex; align-items:center; gap:8px; }
.mp-zalo a { color:#1e40af; font-weight:600; text-decoration:none; word-break:break-all; }
.mp-zalo a:hover { text-decoration:underline; }

.mp-bracket-btn { background:#7c3aed; color:#fff; padding:9px 16px; border-radius:8px; font-size:12.5px; font-weight:700; text-decoration:none; white-space:nowrap; text-align:center; border:none; cursor:pointer; font-family:inherit; }
.mp-bracket-btn:hover { background:#6d28d9; color:#fff; }

.mp-status-row { display:flex; gap:6px; flex-wrap:wrap; align-items:center; margin-bottom:6px; }
.mp-select-tag { display:inline-flex; align-items:center; gap:5px; padding:4px 11px; border-radius:14px; font-size:11.5px; font-weight:700; }
.mp-select-yes { background:#dcfce7; color:#15803d; }
.mp-select-no  { background:#fef2f2; color:#dc2626; }
.mp-select-wait { background:#fef3c7; color:#92400e; }
</style>

<%
function renderItem(it) {
  const s = it.session;
  const en = it.enrollment;
  const ps = en.paymentStatus;
  const isPast = s.date && new Date(s.date) < new Date();
  const dateStr = s.date ? new Date(s.date).toLocaleString('vi-VN', {weekday:'short',day:'2-digit',month:'2-digit',year:'numeric',hour:'2-digit',minute:'2-digit'}) : '';

  let badge = '';
  if (s.status === 'cancelled') badge = '<span class="mp-badge mp-badge-cancelled">Đã hủy</span>';
  else if (s.status === 'done') badge = '<span class="mp-badge mp-badge-done">✓ Đã kết thúc</span>';
  else if (ps === 'requested') badge = '<span class="mp-badge mp-badge-requested"><i class="fas fa-hourglass-half"></i> Chờ admin duyệt</span>';
  else if (ps === 'approved' && en.type === '2M') badge = '<span class="mp-badge mp-badge-approved"><i class="fas fa-check-circle"></i> Đã duyệt</span>';
  else if (ps === 'approved') badge = `<span class="mp-badge mp-badge-approved"><i class="fas fa-check-circle"></i> Đã duyệt — cần thanh toán ${en.amount.toLocaleString('vi-VN')}đ</span>`;
  else if (ps === 'pending') badge = '<span class="mp-badge mp-badge-pending"><i class="fas fa-spinner"></i> Đang xử lý thanh toán</span>';
  else if (ps === 'free') badge = '<span class="mp-badge mp-badge-approved"><i class="fas fa-check-circle"></i> Đã duyệt</span>';
  else if (ps === 'paid') badge = `<span class="mp-badge mp-badge-paid"><i class="fas fa-check-circle"></i> Đã duyệt — đã thanh toán ${en.amount.toLocaleString('vi-VN')}đ</span>`;
  else if (ps === 'rejected') badge = '<span class="mp-badge mp-badge-rejected">✗ Bị từ chối</span>';

  // "Được chọn / không / chờ" highlighted tag
  let selectTag = '';
  if (s.status !== 'cancelled' && s.status !== 'done') {
    if (['paid', 'free', 'approved'].includes(ps)) {
      selectTag = '<span class="mp-select-tag mp-select-yes"><i class="fas fa-check"></i> Bạn đã được chọn</span>';
    } else if (ps === 'rejected') {
      selectTag = '<span class="mp-select-tag mp-select-no"><i class="fas fa-times"></i> Bạn không được chọn</span>';
    } else if (ps === 'requested') {
      selectTag = '<span class="mp-select-tag mp-select-wait"><i class="fas fa-hourglass-half"></i> Đang chờ admin duyệt</span>';
    }
  }

  // Zalo link — chỉ hiện cho người đã được chọn
  const zalo = (['paid', 'free', 'approved'].includes(ps) && s.zaloGroupLink) ? `
    <div class="mp-zalo">
      <i class="fab fa-facebook-messenger" style="color:#3b6fd4"></i>
      <span>Group Zalo: <a href="${s.zaloGroupLink}" target="_blank" rel="noopener">${s.zaloGroupLink}</a></span>
    </div>` : '';

  const snap = (en.snapshotZaloPhone || en.snapshotInGameName || en.snapshotRank) ? `
    <div class="mp-snapshot">
      <span><i class="fas fa-phone"></i> Zalo: <strong>${en.snapshotZaloPhone || '—'}</strong></span>
      <span><i class="fas fa-user"></i> Tên game: <strong>${en.snapshotInGameName || '—'}</strong></span>
      <span><i class="fas fa-trophy"></i> Rank: <strong>${en.snapshotRank ? getRankLabel(en.snapshotRank) : '—'}</strong></span>
    </div>` : '';

  const rejectMsg = (ps === 'rejected' && en.adminNote)
    ? `<div class="mp-reject-msg"><i class="fas fa-exclamation-circle"></i> Lý do: ${en.adminNote}</div>` : '';

  let cta = '';
  if (s.meetLink && (ps === 'paid' || ps === 'free') && s.status === 'scheduled' && !isPast) {
    cta += `<a href="${s.meetLink}" target="_blank" class="mp-meet-btn"><i class="fas fa-video"></i> Tham gia</a>`;
  }
  if (ps === 'approved' && en.type === 'paid') {
    cta += `<form action="/practice/${it.classId}/sessions/${s._id}/pay" method="POST" style="margin:0">
      <button type="submit" class="mp-pay-btn"><i class="fas fa-credit-card"></i> Thanh toán ${en.amount.toLocaleString('vi-VN')}đ</button>
    </form>`;
  }
  // Bracket button — hiện cho mọi enrollment chưa bị từ chối/hủy (xem nhánh đấu kể cả đang chờ duyệt)
  if (!['cancelled'].includes(ps) && s.status !== 'cancelled') {
    cta += `<a href="/practice/${it.classId}/sessions/${s._id}/bracket" class="mp-bracket-btn"><i class="fas fa-sitemap"></i> Xem nhánh đấu</a>`;
  }
  if (['requested','approved','rejected'].includes(ps) && !isPast) {
    cta += `<button class="mp-cancel-btn" onclick="withdraw('${it.classId}','${s._id}')">Hủy yêu cầu</button>`;
  }

  return `
    <div class="mp-card">
      <div class="mp-card-inner">
        <img class="mp-poster" src="${it.poster || 'https://i.ibb.co/wr2CLVVd/default-poster.png'}" alt="${it.className}" />
        <div class="mp-body">
          <div class="mp-name">${s.title || 'Buổi thực hành'}</div>
          <div class="mp-class">
            <a class="mp-class-link" href="/practice/${it.classId}"><i class="fas fa-layer-group"></i> ${it.className}</a>
            <a class="mp-more-btn" href="/practice/${it.classId}" style="margin-left:8px;padding:3px 9px;font-size:11px"><i class="fas fa-plus"></i> Đăng ký thêm buổi</a>
          </div>
          <div class="mp-meta">
            ${s.date ? `<span><i class="fas fa-clock"></i> ${dateStr}${s.endTime ? ' – ' + s.endTime : ''}</span>` : ''}
            ${s.location ? `<span><i class="fas fa-map-marker-alt"></i> ${s.location}</span>` : ''}
            ${it.lecturer ? `<span><i class="fas fa-chalkboard-teacher"></i> ${it.lecturer.name}</span>` : ''}
          </div>
          ${selectTag ? `<div class="mp-status-row">${selectTag}</div>` : ''}
          <div style="display:flex;gap:6px;flex-wrap:wrap">${badge}</div>
          ${zalo}
          ${snap}
          ${rejectMsg}
        </div>
        ${cta ? `<div class="mp-cta">${cta}</div>` : ''}
      </div>
    </div>`;
}

const grouped = { requested: [], approved: [], paid: [], rejected: [], past: [] };
items.forEach(it => {
  const ps = it.enrollment.paymentStatus;
  const isPast = it.session.status === 'done' || it.session.status === 'cancelled' ||
                 (it.session.date && new Date(it.session.date) < new Date());
  if (isPast) grouped.past.push(it);
  else if (ps === 'requested') grouped.requested.push(it);
  else if (ps === 'approved' || ps === 'pending') grouped.approved.push(it);
  else if (ps === 'paid' || ps === 'free') grouped.paid.push(it);
  else if (ps === 'rejected') grouped.rejected.push(it);
});

// Default tab: tab đầu tiên có data, ưu tiên paid (đã đăng ký) → approved → requested → rejected → past
const tabPriority = ['paid', 'approved', 'requested', 'rejected', 'past'];
const defaultTab = tabPriority.find(t => grouped[t].length > 0) || 'paid';

// Distinct classes — để show top section "Các lớp đang tham gia"
const classMap = {};
items.forEach(it => {
  const k = it.classId.toString();
  if (!classMap[k]) {
    classMap[k] = {
      id: k,
      name: it.className,
      poster: it.poster,
      lecturer: it.lecturer,
      pricePerSession: it.pricePerSession,
      total: 0,
      selected: 0,
      pending: 0
    };
  }
  classMap[k].total++;
  const ps = it.enrollment.paymentStatus;
  if (['paid','free','approved'].includes(ps)) classMap[k].selected++;
  if (ps === 'requested') classMap[k].pending++;
});
const myClasses = Object.values(classMap);
%>

<div class="mp-page">
  <div class="mp-wrap">
    <a class="mp-back" href="/practice"><i class="fas fa-arrow-left"></i> Quay lại danh sách lớp thực hành</a>
    <h1 class="mp-title">Buổi thực hành của tôi</h1>
    <% if (userIs2M) { %>
      <div class="mp-sub">
        <i class="fas fa-crown" style="color:#f59e0b"></i>
        Bạn là học viên khóa 2M — học miễn phí, lịch do admin sắp xếp.
      </div>
    <% } else { %>
      <div class="mp-sub">Tổng số yêu cầu/đăng ký: <strong style="color:#1a1f2e"><%= items.length %></strong></div>
    <% } %>

    <% if (items.length === 0) { %>
      <div class="mp-empty mp-empty-big">
        <div style="font-size:48px;margin-bottom:14px">🥅</div>
        <div style="font-size:16px;font-weight:600;color:#4a5568;margin-bottom:6px">Bạn chưa đăng ký buổi thực hành nào</div>
        <a href="/practice" style="color:#3b6fd4;font-size:13px;text-decoration:none">→ Xem các lớp thực hành đang mở</a>
      </div>
    <% } else { %>
      <% if (myClasses.length > 0) { %>
        <div class="mp-section-head">
          <h2><i class="fas fa-layer-group" style="color:#3b6fd4"></i> Lớp đang tham gia — bấm để đăng ký thêm buổi</h2>
          <a class="all-link" href="/practice">Xem tất cả lớp →</a>
        </div>
        <div class="mp-classes">
          <% myClasses.forEach(c => { %>
          <a class="mp-class-card" href="/practice/<%= c.id %>">
            <img class="mp-class-poster" src="<%= c.poster || 'https://i.ibb.co/wr2CLVVd/default-poster.png' %>" alt="<%= c.name %>" />
            <div class="mp-class-info">
              <div class="mp-class-name"><%= c.name %></div>
              <div class="mp-class-stats">
                <% if (c.selected > 0) { %><span class="ok"><i class="fas fa-check-circle"></i> <%= c.selected %> được chọn</span><% } %>
                <% if (c.pending > 0) { %><span class="pending"><i class="fas fa-hourglass-half"></i> <%= c.pending %> chờ duyệt</span><% } %>
              </div>
            </div>
            <i class="mp-class-arrow fas fa-chevron-right"></i>
          </a>
          <% }) %>
        </div>
      <% } %>

      <div class="mp-tabs">
        <button class="mp-tab<%= defaultTab === 'paid' ? ' active' : '' %>" data-tab="paid" onclick="switchTab('paid',this)">
          Đã đăng ký <span class="count"><%= grouped.paid.length %></span>
        </button>
        <button class="mp-tab<%= defaultTab === 'approved' ? ' active' : '' %>" data-tab="approved" onclick="switchTab('approved',this)">
          Đã duyệt / chờ thanh toán <span class="count"><%= grouped.approved.length %></span>
        </button>
        <button class="mp-tab<%= defaultTab === 'requested' ? ' active' : '' %>" data-tab="requested" onclick="switchTab('requested',this)">
          Chờ duyệt <span class="count"><%= grouped.requested.length %></span>
        </button>
        <% if (grouped.rejected.length > 0) { %>
        <button class="mp-tab<%= defaultTab === 'rejected' ? ' active' : '' %>" data-tab="rejected" onclick="switchTab('rejected',this)">
          Bị từ chối <span class="count"><%= grouped.rejected.length %></span>
        </button>
        <% } %>
        <% if (grouped.past.length > 0) { %>
        <button class="mp-tab<%= defaultTab === 'past' ? ' active' : '' %>" data-tab="past" onclick="switchTab('past',this)">
          Đã qua <span class="count"><%= grouped.past.length %></span>
        </button>
        <% } %>
      </div>

      <div class="mp-pane" id="pane-paid" style="display:<%= defaultTab === 'paid' ? 'block' : 'none' %>">
        <% if (grouped.paid.length === 0) { %>
          <div class="mp-empty">Chưa có buổi nào đã đăng ký</div>
        <% } %>
        <% grouped.paid.forEach(it => { %><%- renderItem(it) %><% }) %>
      </div>

      <div class="mp-pane" id="pane-approved" style="display:<%= defaultTab === 'approved' ? 'block' : 'none' %>">
        <% if (grouped.approved.length === 0) { %>
          <div class="mp-empty">Không có buổi nào đã duyệt</div>
        <% } %>
        <% grouped.approved.forEach(it => { %><%- renderItem(it) %><% }) %>
      </div>

      <div class="mp-pane" id="pane-requested" style="display:<%= defaultTab === 'requested' ? 'block' : 'none' %>">
        <% if (grouped.requested.length === 0) { %>
          <div class="mp-empty">Không có yêu cầu nào đang chờ</div>
        <% } %>
        <% grouped.requested.forEach(it => { %><%- renderItem(it) %><% }) %>
      </div>

      <div class="mp-pane" id="pane-rejected" style="display:<%= defaultTab === 'rejected' ? 'block' : 'none' %>">
        <% grouped.rejected.forEach(it => { %><%- renderItem(it) %><% }) %>
      </div>

      <div class="mp-pane" id="pane-past" style="display:<%= defaultTab === 'past' ? 'block' : 'none' %>">
        <% grouped.past.forEach(it => { %><%- renderItem(it) %><% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
function switchTab(tab, btn) {
  document.querySelectorAll('.mp-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.mp-pane').forEach(p => p.style.display = 'none');
  const pane = document.getElementById('pane-' + tab);
  if (pane) pane.style.display = 'block';
}

async function withdraw(classId, sessionId) {
  if (!confirm('Hủy yêu cầu đăng ký buổi này?')) return;
  try {
    const res = await fetch('/practice/' + classId + '/sessions/' + sessionId + '/withdraw', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }
    });
    const json = await res.json();
    if (json.ok) location.reload();
    else alert(json.msg || 'Không thể hủy yêu cầu');
  } catch(e) {
    alert('Lỗi kết nối');
  }
}
</script>

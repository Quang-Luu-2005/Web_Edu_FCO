<style>
.pd-page { min-height:calc(100vh - 120px); background:#f8f7f4; padding:40px 0 64px; }
.pd-wrap { width:85%; max-width:980px; margin:0 auto; }
.pd-back { display:inline-block; color:#3b6fd4; font-size:13px; margin-bottom:14px; text-decoration:none; }
.pd-back:hover { text-decoration:underline; }

.pd-header { background:#fff; border:1px solid #e8e8e4; border-radius:14px; overflow:hidden; margin-bottom:18px; }
.pd-poster { width:100%; aspect-ratio:21/8; object-fit:cover; background:#e8e8e4; }
.pd-info { padding:22px 26px; }
.pd-info-top { display:flex; gap:18px; align-items:flex-start; flex-wrap:wrap; }
.pd-info-main { flex:1; min-width:240px; }
.pd-title { font-size:24px; font-weight:800; color:#1a1f2e; margin:0 0 8px; }
.pd-desc { font-size:14px; color:#4a5568; line-height:1.55; margin:0 0 14px; }
.pd-lecturer { display:flex; align-items:center; gap:10px; padding-top:12px; border-top:1px solid #f1f5f9; }
.pd-lecturer img { width:40px; height:40px; border-radius:50%; object-fit:cover; }
.pd-lec-name { font-size:14px; font-weight:600; color:#1a1f2e; }
.pd-lec-sub { font-size:12px; color:#9ca3af; }

/* Follow button */
.pd-follow-box { flex:0 0 auto; min-width:200px; text-align:right; }
.pd-follow-count { font-size:12px; color:#9ca3af; margin-bottom:8px; }
.pd-follow-count strong { color:#1a1f2e; font-size:15px; }
.pd-follow-btn { background:#3b6fd4; color:#fff; border:none; padding:10px 22px; border-radius:24px; font-size:13px; font-weight:700; cursor:pointer; transition:all 0.15s; display:inline-flex; align-items:center; gap:7px; font-family:inherit; }
.pd-follow-btn:hover { background:#2c54a8; }
.pd-follow-btn.following { background:#fff; color:#3b6fd4; border:1.5px solid #3b6fd4; }
.pd-follow-btn.following:hover { background:#fef2f2; color:#dc2626; border-color:#dc2626; }
.pd-follow-btn.following:hover .follow-text::before { content:"Bỏ theo dõi"; }
.pd-follow-btn.following:hover .follow-text-default { display:none; }

/* Banner */
.pd-banner { padding:14px 18px; border-radius:10px; margin-bottom:14px; font-size:14px; display:flex; align-items:center; gap:10px; }
.pd-banner-2m    { background:#fef3c7; color:#92400e; border:1px solid #fde68a; }
.pd-banner-paid  { background:#eff4ff; color:#1e40af; border:1px solid #c7d7f5; }
.pd-banner-guest { background:#f3f4f6; color:#4a5568; border:1px solid #e5e7eb; }
.pd-banner-warn  { background:#fef2f2; color:#991b1b; border:1px solid #fecaca; }
.pd-banner a { font-weight:700; text-decoration:underline; }

.pd-section { display:flex; align-items:center; justify-content:space-between; margin:24px 0 14px; }
.pd-section-title { font-size:18px; font-weight:700; color:#1a1f2e; margin:0; }
.pd-section-sub { font-size:12px; color:#9ca3af; }

/* Session card — dạng list rõ ràng */
.s-card { background:#fff; border:1px solid #e8e8e4; border-radius:12px; padding:18px 20px; margin-bottom:12px; display:flex; gap:18px; align-items:center; flex-wrap:wrap; transition:border-color 0.15s, box-shadow 0.15s; }
.s-card:hover { border-color:#cbd5e1; box-shadow:0 2px 8px rgba(26,31,46,0.04); }
.s-card.enrolled { border-color:#bfdbfe; background:#fafcff; }
.s-date-block { flex:0 0 auto; text-align:center; min-width:64px; padding-right:18px; border-right:1px solid #f1f5f9; }
.s-date-day { font-size:11px; font-weight:700; color:#9ca3af; text-transform:uppercase; letter-spacing:0.5px; }
.s-date-num { font-size:30px; font-weight:800; color:#1a1f2e; line-height:1; margin:4px 0 2px; }
.s-date-month { font-size:11px; color:#6b7280; }
.s-info { flex:1; min-width:200px; }
.s-title { font-size:15px; font-weight:700; color:#1a1f2e; margin:0 0 6px; }
.s-meta { font-size:12.5px; color:#6b7280; display:flex; gap:14px; flex-wrap:wrap; }
.s-meta i { color:#9ca3af; }
.s-meta-line { display:flex; align-items:center; gap:5px; }

.s-action { flex:0 0 auto; display:flex; flex-direction:column; align-items:flex-end; gap:6px; }
.s-btn-register { background:#3b6fd4; color:#fff; border:none; padding:10px 22px; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer; font-family:inherit; transition:background 0.15s; white-space:nowrap; }
.s-btn-register:hover { background:#2c54a8; }
.s-btn-register:disabled { background:#cbd5e1; cursor:not-allowed; }
.s-btn-meet { background:#16a34a; color:#fff; padding:9px 18px; border-radius:8px; font-size:12.5px; font-weight:700; text-decoration:none; display:inline-flex; align-items:center; gap:5px; white-space:nowrap; }
.s-btn-meet:hover { background:#15803d; color:#fff; }
.s-status { font-size:11.5px; font-weight:700; padding:4px 11px; border-radius:14px; white-space:nowrap; display:inline-flex; align-items:center; gap:5px; }
.s-status-requested { background:#fef3c7; color:#92400e; }
.s-status-approved  { background:#dbeafe; color:#1e40af; }
.s-status-paid      { background:#dcfce7; color:#15803d; }
.s-status-free      { background:#fde68a; color:#92400e; }
.s-status-rejected  { background:#fef2f2; color:#dc2626; }
.s-status-pending   { background:#e2e8f0; color:#475569; }
.s-status-full      { background:#e2e8f0; color:#9ca3af; }

.s-reject-msg { width:100%; font-size:12px; color:#dc2626; margin-top:8px; padding:6px 10px; background:#fef2f2; border-radius:6px; }

.empty-state { background:#fff; border:1px solid #e8e8e4; border-radius:12px; padding:40px; text-align:center; color:#9ca3af; }
.empty-state i { font-size:32px; display:block; margin-bottom:10px; }
.empty-state .em-title { font-size:14px; font-weight:600; color:#4a5568; margin-bottom:4px; }

/* Modal xác nhận */
.cf-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,0.65); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px); }
.cf-overlay.open { display:flex; }
.cf-box { background:#fff; border-radius:16px; padding:26px; width:100%; max-width:480px; max-height:85vh; overflow-y:auto; box-shadow:0 24px 60px rgba(0,0,0,0.3); }
.cf-title { font-size:18px; font-weight:800; color:#1a1f2e; margin:0 0 6px; }
.cf-sub { font-size:13px; color:#6b7280; margin-bottom:18px; }
.cf-section { background:#fafaf8; border:1px solid #ececec; border-radius:10px; padding:14px 16px; margin-bottom:12px; }
.cf-section-title { font-size:11px; font-weight:700; color:#9ca3af; letter-spacing:0.5px; text-transform:uppercase; margin-bottom:8px; }
.cf-row { display:flex; justify-content:space-between; padding:5px 0; font-size:13px; }
.cf-row .label { color:#6b7280; }
.cf-row .val { color:#1a1f2e; font-weight:600; max-width:60%; text-align:right; word-break:break-word; }
.cf-warn { background:#fef3c7; color:#92400e; padding:10px 14px; border-radius:8px; font-size:12.5px; margin-bottom:12px; line-height:1.5; }
.cf-actions { display:flex; gap:10px; justify-content:flex-end; margin-top:16px; }
.btn-primary { background:#3b6fd4; color:#fff; border:none; padding:10px 22px; border-radius:8px; font-weight:700; font-size:13px; cursor:pointer; font-family:inherit; }
.btn-primary:hover { background:#2c54a8; }
.btn-primary:disabled { background:#cbd5e1; cursor:not-allowed; }
.btn-ghost { background:transparent; color:#64748b; border:1px solid #e5e7eb; padding:9px 16px; border-radius:8px; font-size:13px; cursor:pointer; font-family:inherit; }

@media (max-width:640px) {
  .s-card { padding:14px; }
  .s-date-block { padding-right:12px; min-width:54px; }
  .s-action { width:100%; align-items:stretch; }
  .s-btn-register, .s-btn-meet { width:100%; text-align:center; justify-content:center; }
}
</style>

<div class="pd-page">
  <div class="pd-wrap">
    <a href="/practice" class="pd-back">← Quay lại danh sách lớp thực hành</a>

    <div class="pd-header">
      <img class="pd-poster" src="<%= cls.poster || 'https://i.ibb.co/wr2CLVVd/default-poster.png' %>" alt="<%= cls.name %>" />
      <div class="pd-info">
        <div class="pd-info-top">
          <div class="pd-info-main">
            <h1 class="pd-title"><%= cls.name %></h1>
            <% if (cls.description) { %><p class="pd-desc"><%= cls.description %></p><% } %>
            <% if (cls.idLecturer) { %>
            <div class="pd-lecturer">
              <img src="<%= cls.idLecturer.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>" />
              <div>
                <div class="pd-lec-name"><%= cls.idLecturer.name %></div>
                <div class="pd-lec-sub">Huấn luyện viên</div>
              </div>
            </div>
            <% } %>
          </div>

          <div class="pd-follow-box">
            <div class="pd-follow-count"><strong id="follower-count"><%= followerCount %></strong> người theo dõi</div>
            <% if (isAuthenticated) { %>
              <button class="pd-follow-btn <%= isFollowing ? 'following' : '' %>" id="follow-btn" onclick="toggleFollow()">
                <i class="fas <%= isFollowing ? 'fa-check' : 'fa-plus' %>" id="follow-icon"></i>
                <span class="follow-text">
                  <span class="follow-text-default" id="follow-label"><%= isFollowing ? 'Đang theo dõi' : 'Theo dõi lớp' %></span>
                </span>
              </button>
            <% } else { %>
              <a href="/users/login" class="pd-follow-btn"><i class="fas fa-sign-in-alt"></i> Đăng nhập để theo dõi</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <% if (!isAuthenticated) { %>
      <div class="pd-banner pd-banner-guest">
        <i class="fas fa-info-circle"></i>
        <span><a href="/users/login" style="color:#3b6fd4">Đăng nhập</a> để theo dõi lớp và đăng ký buổi thực hành.</span>
      </div>
    <% } else if (userIs2M) { %>
      <div class="pd-banner pd-banner-2m">
        <i class="fas fa-crown"></i>
        <span>Bạn là <strong>học viên khóa 2M</strong> — học miễn phí. Yêu cầu đăng ký sẽ được admin xem xét và sắp xếp.</span>
      </div>
    <% } else { %>
      <div class="pd-banner pd-banner-paid">
        <i class="fas fa-tag"></i>
        <span>Phí mỗi buổi: <strong><%= cls.pricePerSession.toLocaleString('vi-VN') %>đ</strong> — thanh toán sau khi admin duyệt yêu cầu.</span>
      </div>
    <% } %>

    <% if (isAuthenticated && !profileComplete) { %>
      <div class="pd-banner pd-banner-warn">
        <i class="fas fa-exclamation-triangle"></i>
        <span>Bạn cần điền đầy đủ <strong>SĐT Zalo, tên trong game và mức rank</strong> trước khi đăng ký buổi. <a href="/users/account">Cập nhật ngay →</a></span>
      </div>
    <% } %>

    <div class="pd-section">
      <h2 class="pd-section-title"><i class="fas fa-calendar-alt" style="color:#3b6fd4"></i> Các buổi sắp tới</h2>
      <span class="pd-section-sub"><%= upcomingSessions.length %> buổi</span>
    </div>

    <% if (upcomingSessions.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-calendar-plus"></i>
        <div class="em-title">Chưa có buổi nào được lên lịch</div>
        <div style="font-size:12.5px;color:#9ca3af">
          <% if (isAuthenticated && !isFollowing) { %>
            Hãy theo dõi lớp để được cập nhật khi có buổi mới.
          <% } else if (isFollowing) { %>
            Bạn sẽ thấy ngay khi admin tạo buổi mới.
          <% } else { %>
            Quay lại sau nhé.
          <% } %>
        </div>
      </div>
    <% } %>

    <% upcomingSessions.forEach(s => {
      const state = userId ? userSessionState[s._id.toString()] : null;
      const enrolled = state && state.enrolled;
      const enType = state && state.type;
      const payStatus = state && state.paymentStatus;
      const adminNote = state && state.adminNote;

      const selectedCount  = (s.enrollments || []).filter(e => ['paid','free','approved'].includes(e.paymentStatus)).length;
      const requestedCount = (s.enrollments || []).filter(e => e.paymentStatus === 'requested').length;
      const isFull = selectedCount >= cls.maxStudentsPerSession;

      const d = s.date ? new Date(s.date) : null;
      const dayName  = d ? d.toLocaleDateString('vi-VN', { weekday: 'short' }) : '—';
      const dayNum   = d ? d.getDate() : '?';
      const monthStr = d ? `Th${d.getMonth() + 1}` : '';
      const timeStr  = d ? d.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' }) : '';
      const fullDate = d ? d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric' }) : '';

      const canRegister = !enrolled && profileComplete && isAuthenticated && s.status === 'scheduled';
    %>
    <div class="s-card <%= enrolled && ['paid','free','approved','requested'].includes(payStatus) ? 'enrolled' : '' %>" data-sid="<%= s._id %>">
      <div class="s-date-block">
        <div class="s-date-day"><%= dayName %></div>
        <div class="s-date-num"><%= dayNum %></div>
        <div class="s-date-month"><%= monthStr %></div>
      </div>
      <div class="s-info">
        <div class="s-title"><%= s.title || 'Buổi thực hành' %></div>
        <div class="s-meta">
          <% if (timeStr) { %>
          <span class="s-meta-line"><i class="fas fa-clock"></i> <%= timeStr %><% if (s.endTime) { %> – <%= s.endTime %><% } %> · <%= fullDate %></span>
          <% } %>
          <% if (s.location) { %>
          <span class="s-meta-line"><i class="fas fa-map-marker-alt"></i> <%= s.location %></span>
          <% } %>
          <span class="s-meta-line"><i class="fas fa-user-check"></i> <%= selectedCount %>/<%= cls.maxStudentsPerSession %> được chọn</span>
          <% if (requestedCount > 0) { %>
          <span class="s-meta-line" style="color:#d97706"><i class="fas fa-hourglass-half"></i> <%= requestedCount %> chờ duyệt</span>
          <% } %>
        </div>
        <% if (s.note) { %><div style="font-size:12px;color:#9ca3af;margin-top:6px;font-style:italic"><%= s.note %></div><% } %>
        <% if (enrolled && payStatus === 'rejected' && adminNote) { %>
        <div class="s-reject-msg"><i class="fas fa-times-circle"></i> Lý do từ chối: <%= adminNote %></div>
        <% } %>
      </div>
      <div class="s-action">
        <% if (s.status === 'cancelled') { %>
          <span class="s-status s-status-pending">Đã hủy</span>
        <% } else if (enrolled && payStatus === 'requested') { %>
          <span class="s-status s-status-requested"><i class="fas fa-hourglass-half"></i> Chờ duyệt</span>
        <% } else if (enrolled && payStatus === 'approved' && enType === '2M') { %>
          <span class="s-status s-status-approved">✓ Đã duyệt</span>
        <% } else if (enrolled && payStatus === 'approved') { %>
          <form action="/practice/<%= cls._id %>/sessions/<%= s._id %>/pay" method="POST" style="margin:0">
            <button type="submit" style="background:#16a34a;color:#fff;border:none;padding:10px 18px;border-radius:8px;font-size:12.5px;font-weight:700;cursor:pointer">
              <i class="fas fa-credit-card"></i> Thanh toán <%= cls.pricePerSession.toLocaleString('vi-VN') %>đ
            </button>
          </form>
        <% } else if (enrolled && payStatus === 'paid') { %>
          <span class="s-status s-status-paid">✓ Đã thanh toán</span>
          <% if (s.meetLink) { %><a href="<%= s.meetLink %>" target="_blank" class="s-btn-meet"><i class="fas fa-video"></i> Tham gia</a><% } %>
        <% } else if (enrolled && payStatus === 'free') { %>
          <span class="s-status s-status-free"><i class="fas fa-crown"></i> 2M miễn phí</span>
          <% if (s.meetLink) { %><a href="<%= s.meetLink %>" target="_blank" class="s-btn-meet"><i class="fas fa-video"></i> Tham gia</a><% } %>
        <% } else if (enrolled && payStatus === 'pending') { %>
          <span class="s-status s-status-pending">Đang xử lý</span>
        <% } else if (enrolled && payStatus === 'rejected') { %>
          <button class="s-btn-register" onclick='openConfirmModal(<%- JSON.stringify({ sid: s._id.toString(), title: s.title || "Buổi thực hành", time: timeStr, fullDate }) %>)'>Đăng ký lại</button>
        <% } else if (canRegister) { %>
          <button class="s-btn-register" onclick='openConfirmModal(<%- JSON.stringify({ sid: s._id.toString(), title: s.title || "Buổi thực hành", time: timeStr, fullDate }) %>)'>
            <i class="fas fa-paper-plane"></i> Đăng ký buổi này
          </button>
          <% if (isFull) { %><span style="font-size:11px;color:#9ca3af">Đã đủ chỗ — bạn vẫn có thể vào danh sách chờ</span><% } %>
        <% } else if (!isAuthenticated) { %>
          <a href="/users/login" class="s-btn-register" style="text-decoration:none;display:inline-block">Đăng nhập để đăng ký</a>
        <% } else if (!profileComplete) { %>
          <a href="/users/account" class="s-btn-register" style="background:#d97706;text-decoration:none;display:inline-block">Cập nhật hồ sơ</a>
        <% } %>
      </div>
    </div>
    <% }); %>

    <% if (pastSessions.length > 0) { %>
    <details style="margin-top:18px">
      <summary style="cursor:pointer;color:#9ca3af;font-size:13px;font-weight:600;padding:8px 0">📜 Xem các buổi đã qua (<%= pastSessions.length %>)</summary>
      <% pastSessions.forEach(s => {
        const d = s.date ? new Date(s.date) : null;
        const fullDate = d ? d.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric' }) : '';
        const timeStr  = d ? d.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' }) : '';
        const dayName  = d ? d.toLocaleDateString('vi-VN', { weekday: 'short' }) : '—';
      %>
      <div class="s-card" style="opacity:0.55;margin-top:10px">
        <div class="s-date-block">
          <div class="s-date-day"><%= dayName %></div>
          <div class="s-date-num"><%= d ? d.getDate() : '?' %></div>
          <div class="s-date-month"><%= d ? 'Th' + (d.getMonth() + 1) : '' %></div>
        </div>
        <div class="s-info">
          <div class="s-title"><%= s.title || 'Buổi thực hành' %></div>
          <div class="s-meta"><span><i class="fas fa-clock"></i> <%= timeStr %> · <%= fullDate %></span></div>
        </div>
        <div class="s-action">
          <span class="s-status s-status-pending">
            <%= s.status === 'cancelled' ? 'Đã hủy' : 'Đã qua' %>
          </span>
        </div>
      </div>
      <% }); %>
    </details>
    <% } %>
  </div>
</div>

<!-- Modal xác nhận đăng ký 1 buổi -->
<div class="cf-overlay" id="cf-overlay">
  <div class="cf-box">
    <h2 class="cf-title">Xác nhận đăng ký buổi</h2>
    <p class="cf-sub">Vui lòng kiểm tra thông tin trước khi gửi yêu cầu cho admin.</p>

    <div class="cf-section">
      <div class="cf-section-title">Buổi đã chọn</div>
      <div class="cf-row"><span class="label">Tiêu đề</span><span class="val" id="cf-session-title">—</span></div>
      <div class="cf-row"><span class="label">Thời gian</span><span class="val" id="cf-session-time">—</span></div>
    </div>

    <div class="cf-section">
      <div class="cf-section-title">Hồ sơ của bạn</div>
      <div class="cf-row"><span class="label">SĐT Zalo</span><span class="val"><%= isAuthenticated ? (user.zaloPhone || '—') : '—' %></span></div>
      <div class="cf-row"><span class="label">Tên trong game</span><span class="val"><%= isAuthenticated ? (user.inGameName || '—') : '—' %></span></div>
      <div class="cf-row"><span class="label">Mức rank</span><span class="val"><%= isAuthenticated && user.rank ? getRankLabel(user.rank) : '—' %></span></div>
    </div>

    <% if (!userIs2M) { %>
    <div class="cf-warn">
      <i class="fas fa-info-circle"></i> <strong>Lưu ý:</strong> Sau khi admin duyệt, bạn sẽ thanh toán <strong><%= cls.pricePerSession.toLocaleString('vi-VN') %>đ</strong> để hoàn tất đăng ký.
    </div>
    <% } else { %>
    <div class="cf-warn" style="background:#fef3c7">
      <i class="fas fa-crown"></i> <strong>Học viên 2M:</strong> Sau khi admin duyệt, bạn được tham gia miễn phí.
    </div>
    <% } %>

    <p style="font-size:12px;color:#6b7280;margin:10px 0 0">
      Hồ sơ chưa đúng? <a href="/users/account" style="color:#3b6fd4;font-weight:700">Cập nhật tại đây</a>.
    </p>

    <div class="cf-actions">
      <button class="btn-ghost" onclick="closeConfirmModal()">Quay lại</button>
      <button class="btn-primary" id="cf-submit-btn" onclick="submitRegister()">
        <i class="fas fa-paper-plane"></i> Gửi yêu cầu
      </button>
    </div>
  </div>
</div>

<script>
const CLS_ID = '<%= cls._id %>';
let _selectedSid = null;

function openConfirmModal(data) {
  _selectedSid = data.sid;
  document.getElementById('cf-session-title').textContent = data.title;
  document.getElementById('cf-session-time').textContent  = data.time + ' · ' + data.fullDate;
  document.getElementById('cf-overlay').classList.add('open');
}

function closeConfirmModal() {
  document.getElementById('cf-overlay').classList.remove('open');
  _selectedSid = null;
}

async function submitRegister() {
  if (!_selectedSid) return;
  const btn = document.getElementById('cf-submit-btn');
  btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang gửi...';
  try {
    const res = await fetch('/practice/' + CLS_ID + '/sessions/' + _selectedSid + '/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const json = await res.json();
    if (json.ok) {
      alert(json.msg || 'Đã gửi yêu cầu thành công!');
      location.reload();
    } else {
      alert(json.msg || 'Có lỗi xảy ra');
      btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi yêu cầu';
    }
  } catch(e) {
    alert('Lỗi kết nối, thử lại sau.');
    btn.disabled = false; btn.innerHTML = '<i class="fas fa-paper-plane"></i> Gửi yêu cầu';
  }
}

// Click outside modal để đóng
document.getElementById('cf-overlay').addEventListener('click', (e) => {
  if (e.target.id === 'cf-overlay') closeConfirmModal();
});

// ── Toggle follow ──
async function toggleFollow() {
  const btn = document.getElementById('follow-btn');
  btn.disabled = true;
  try {
    const res = await fetch('/practice/' + CLS_ID + '/follow', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }
    });
    const json = await res.json();
    if (json.ok) {
      document.getElementById('follower-count').textContent = json.followerCount;
      const icon = document.getElementById('follow-icon');
      const label = document.getElementById('follow-label');
      if (json.following) {
        btn.classList.add('following');
        icon.className = 'fas fa-check';
        label.textContent = 'Đang theo dõi';
      } else {
        btn.classList.remove('following');
        icon.className = 'fas fa-plus';
        label.textContent = 'Theo dõi lớp';
      }
    }
  } catch(e) {
    alert('Lỗi kết nối, thử lại sau.');
  } finally {
    btn.disabled = false;
  }
}
</script>

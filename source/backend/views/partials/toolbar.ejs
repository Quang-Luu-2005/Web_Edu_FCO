</head>
<header id="header" class="navbar navbar-static-top">
  <div class="container-fluid">
    <div class="col-sm-2">
      <div id="header-logo" class="navbar-header">
        <a href="/" class="navbar-brand">
          <img src="https://i.ibb.co/69L9ymq/image-removebg-preview.png" alt="MansterClass" title="MansterClass" />
        </a>
      </div>
    </div>
    <div class="col-sm-10 featured" style="margin-left:auto">
      <div class="toolbar-actions">
        <% if (!isAuthenticated) { %>
        <a class="btn btn-sm btn-outline-light toolbar-btn" href="/users/login">
          <i class="fas fa-sign-in-alt"></i> Đăng nhập
        </a>
        <% } else { %>
        <div class="nav-item dropdown toolbar-bell" id="practiceBell">
          <a href="#" id="practiceBellBtn" class="nav-link toolbar-btn toolbar-bell-btn" title="Thông báo lớp thực hành">
            <i class="fas fa-bell"></i>
            <span class="toolbar-bell-badge" id="practiceBellBadge" style="display:none">0</span>
          </a>
          <div class="toolbar-bell-panel" id="practiceBellPanel" style="display:none">
            <div class="bell-head">
              <strong><i class="fas fa-bell"></i> Thông báo</strong>
              <a href="/practice/my" class="bell-all">Xem tất cả</a>
            </div>
            <div class="bell-list" id="practiceBellList">
              <div class="bell-empty"><i class="fas fa-inbox"></i><div>Đang tải...</div></div>
            </div>
          </div>
        </div>
        <div class="nav-item dropdown toolbar-user">
          <a href="#" data-toggle="dropdown" class="nav-link dropdown-toggle toolbar-btn toolbar-user-btn">
            <img src="<%= user.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>"
              class="toolbar-avatar" alt="avatar" />
            <span class="toolbar-username"><%= user.name || user.username %></span>
          </a>
          <ul class="dropdown-menu toolbar-dropdown">
            <li class="dropdown-header-item">
              <img src="<%= user.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>"
                class="dd-avatar" alt="avatar" />
              <div>
                <div class="dd-name"><%= user.name || user.username %></div>
                <div class="dd-email"><%= user.email %></div>
              </div>
            </li>
            <li class="dd-divider"></li>
            <li>
              <a href="/users/account" class="dd-item">
                <i class="fas fa-user-circle"></i> Hồ sơ
              </a>
            </li>
            <li>
              <a href="/my-courses" class="dd-item">
                <i class="fas fa-book-open"></i> Khóa học của tôi
              </a>
            </li>
            <li>
              <a href="/payment/history" class="dd-item">
                <i class="fas fa-receipt"></i> Lịch sử thanh toán
              </a>
            </li>
            <li>
              <a href="/classes/my-classes" class="dd-item">
                <i class="fas fa-chalkboard"></i> Lớp học của tôi
              </a>
            </li>
            <li>
              <a href="/practice/my" class="dd-item">
                <i class="fas fa-futbol"></i> Buổi thực hành của tôi
              </a>
            </li>
            <li>
              <a href="/my-wish-list" class="dd-item">
                <i class="fas fa-heart"></i> Danh sách yêu thích
              </a>
            </li>
            <% if (user.role === 'admin' || user.role === 'lecturer') { %>
            <li class="dd-divider"></li>
            <li>
              <a href="/admin/homepage" class="dd-item dd-item-admin">
                <i class="fas fa-shield-alt"></i> Quản lý
              </a>
            </li>
            <% } %>
            <li class="dd-divider"></li>
            <li>
              <a href="/users/logout" class="dd-item dd-item-danger">
                <i class="fas fa-sign-out-alt"></i> Đăng xuất
              </a>
            </li>
          </ul>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</header>

<style>
.toolbar-bell { position: relative; flex: 0 0 auto; }
.toolbar-bell-btn {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  padding: 0 !important;
  border-radius: 50% !important;
  background: rgba(255,255,255,0.08) !important;
  border: 1px solid rgba(255,255,255,0.15) !important;
  color: #fff !important;
  text-decoration: none !important;
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  position: relative;
}
.toolbar-bell-btn:hover { background: rgba(255,255,255,0.14) !important; color: #fbbf24 !important; }
.toolbar-bell-btn i { font-size: 15px; margin: 0 !important; line-height: 1; }
.toolbar-bell-badge {
  position: absolute;
  top: -3px;
  right: -3px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: #dc2626;
  color: #fff !important;
  font-size: 10.5px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 2px solid #1a1f2e;
  box-sizing: content-box;
}
.toolbar-bell-panel {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  width: 360px;
  max-width: 92vw;
  background: #fff;
  border: 1px solid #e8e8e4;
  border-radius: 12px;
  box-shadow: 0 12px 40px rgba(26,31,46,0.18);
  overflow: hidden;
  z-index: 1000;
}
.toolbar-bell-panel .bell-head { padding: 12px 16px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; }
.toolbar-bell-panel .bell-head strong { color: #1a1f2e; font-size: 14px; }
.toolbar-bell-panel .bell-head .bell-all { font-size: 12px; color: #3b6fd4 !important; text-decoration: none; }
.toolbar-bell-panel .bell-head .bell-all:hover { text-decoration: underline; color: #3b6fd4 !important; }
.toolbar-bell-panel .bell-list { max-height: 420px; overflow-y: auto; }
.toolbar-bell-panel .bell-item { display: block; padding: 12px 16px; border-bottom: 1px solid #f1f5f9; text-decoration: none !important; color: inherit !important; transition: background 0.15s; }
.toolbar-bell-panel .bell-item:hover { background: #fafaf8; color: inherit !important; }
.toolbar-bell-panel .bell-item:last-child { border-bottom: none; }
.toolbar-bell-panel .bell-item .bell-title { font-size: 13px; font-weight: 700; color: #1a1f2e; margin-bottom: 3px; display: flex; align-items: center; gap: 6px; }
.toolbar-bell-panel .bell-item .bell-sub { font-size: 12px; color: #718096; line-height: 1.4; }
.toolbar-bell-panel .bell-item .bell-time { font-size: 11px; color: #9ca3af; margin-top: 4px; }
.toolbar-bell-panel .bell-item.bell-yes .bell-title { color: #15803d; }
.toolbar-bell-panel .bell-item.bell-no  .bell-title { color: #dc2626; }
.toolbar-bell-panel .bell-empty { padding: 28px 16px; text-align: center; color: #9ca3af; font-size: 13px; }
.toolbar-bell-panel .bell-empty i { font-size: 24px; color: #cbd5e1; display: block; margin-bottom: 6px; }
</style>

<% if (isAuthenticated) { %>
<script>
(function(){
  const bell = document.getElementById('practiceBell');
  if (!bell) return;
  const btn = document.getElementById('practiceBellBtn');
  const panel = document.getElementById('practiceBellPanel');
  const badge = document.getElementById('practiceBellBadge');
  const list = document.getElementById('practiceBellList');
  let loaded = false;

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function fmtTime(d) {
    if (!d) return '';
    const dt = new Date(d);
    const dd = String(dt.getDate()).padStart(2, '0');
    const mm = String(dt.getMonth() + 1).padStart(2, '0');
    const yyyy = dt.getFullYear();
    const hh = String(dt.getHours()).padStart(2, '0');
    const mi = String(dt.getMinutes()).padStart(2, '0');
    return `${dd}/${mm}/${yyyy} ${hh}:${mi}`;
  }

  function renderItems(items) {
    if (!items || items.length === 0) {
      list.innerHTML = '<div class="bell-empty"><i class="fas fa-inbox"></i><div>Chưa có thông báo mới</div></div>';
      return;
    }
    list.innerHTML = items.map(n => {
      const isYes = n.status === 'free' || n.status === 'approved';
      const cls = isYes ? 'bell-yes' : 'bell-no';
      const icon = isYes ? '<i class="fas fa-check-circle"></i>' : '<i class="fas fa-times-circle"></i>';
      const title = isYes ? 'Bạn đã được chọn' : 'Yêu cầu bị từ chối';
      const sub = `${escapeHtml(n.sessionTitle || 'Buổi thực hành')} — ${escapeHtml(n.className || '')}`;
      const href = `/practice/${n.classId}/sessions/${n.sessionId}/bracket`;
      return `<a class="bell-item ${cls}" href="${href}">
        <div class="bell-title">${icon} ${title}</div>
        <div class="bell-sub">${sub}</div>
        <div class="bell-time">${fmtTime(n.reviewedAt)}</div>
      </a>`;
    }).join('');
  }

  async function fetchCount() {
    try {
      const res = await fetch('/practice/notifications', { credentials: 'same-origin' });
      if (!res.ok) return;
      const json = await res.json();
      const items = json.notifications || [];
      if (items.length > 0) {
        badge.textContent = items.length > 9 ? '9+' : items.length;
        badge.style.display = 'inline-flex';
      } else {
        badge.style.display = 'none';
      }
      if (loaded) renderItems(items);
      return items;
    } catch(e) { return []; }
  }

  async function openPanel() {
    panel.style.display = 'block';
    list.innerHTML = '<div class="bell-empty"><i class="fas fa-spinner fa-spin"></i><div>Đang tải...</div></div>';
    const items = await fetchCount();
    renderItems(items || []);
    loaded = true;
    // Mark all seen
    try {
      await fetch('/practice/notifications/seen', { method: 'POST', credentials: 'same-origin' });
      badge.style.display = 'none';
    } catch(e) {}
  }

  btn.addEventListener('click', (e) => {
    e.preventDefault();
    if (panel.style.display === 'none' || !panel.style.display) openPanel();
    else panel.style.display = 'none';
  });

  document.addEventListener('click', (e) => {
    if (!bell.contains(e.target)) panel.style.display = 'none';
  });

  // Initial check + poll mỗi 60s
  fetchCount();
  setInterval(fetchCount, 60000);
})();
</script>
<% } %>

<style>
.mc-page { min-height:calc(100vh - 120px); background:#f8f7f4; padding:40px 0 64px; }
.mc-wrap { width:85%; max-width:1000px; margin:0 auto; }
.mc-title { font-size:26px; font-weight:700; color:#1a1f2e; margin-bottom:24px; }

.cls-card {
  background:#fff; border:1px solid #e8e8e4; border-radius:14px;
  overflow:hidden; box-shadow:0 2px 8px rgba(26,31,46,0.05);
  transition:box-shadow 0.2s, transform 0.2s; margin-bottom:12px;
}
.cls-card:hover { box-shadow:0 6px 20px rgba(26,31,46,0.10); transform:translateY(-2px); }
.cls-card-inner { display:flex; align-items:center; gap:0; text-decoration:none; color:inherit; }
.cls-poster { width:160px; height:100px; object-fit:cover; flex:0 0 160px; background:#e8e8e4; }
.cls-body { flex:1; padding:16px 20px; min-width:0; }
.cls-name { font-size:16px; font-weight:700; color:#1a1f2e; margin-bottom:4px; }
.cls-course { font-size:13px; color:#9ca3af; margin-bottom:8px; }
.cls-meta { display:flex; gap:12px; flex-wrap:wrap; font-size:12px; color:#718096; }
.cls-badge { display:inline-flex; align-items:center; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600; }
.cls-badge-open      { background:#eff4ff; color:#3b6fd4; }
.cls-badge-ongoing   { background:#dcfce7; color:#15803d; }
.cls-badge-completed { background:#fef9ec; color:#b45309; }
.cls-badge-cancelled { background:#fef2f2; color:#dc2626; }
.cls-arrow { flex:0 0 auto; padding:16px 20px; color:#9ca3af; font-size:18px; }
</style>

<div class="mc-page">
  <div class="mc-wrap">
    <h1 class="mc-title">Lớp học của tôi</h1>

    <% if (classes.length === 0) { %>
    <div style="background:#fff;border:1px solid #e8e8e4;border-radius:14px;text-align:center;padding:64px 24px">
      <div style="font-size:48px;margin-bottom:16px">📚</div>
      <div style="font-size:18px;font-weight:700;color:#4a5568;margin-bottom:8px">Bạn chưa được thêm vào lớp nào</div>
      <div style="font-size:14px;color:#9ca3af">Liên hệ giảng viên để được thêm vào lớp học.</div>
    </div>
    <% } else { %>
      <% classes.forEach(cls => {
        const badgeClass = { open:'cls-badge-open', ongoing:'cls-badge-ongoing', completed:'cls-badge-completed', cancelled:'cls-badge-cancelled' }[cls.status] || 'cls-badge-open';
        const statusLabel = { open:'Mở đăng ký', ongoing:'Đang học', completed:'Hoàn thành', cancelled:'Đã hủy' }[cls.status] || cls.status;
        const doneSessions = cls.sessions.filter(s => s.status === 'done').length;
      %>
      <div class="cls-card">
        <a class="cls-card-inner" href="/classes/my-classes/<%= cls._id %>">
          <img class="cls-poster" src="<%= cls.idCourse && cls.idCourse.poster || 'https://i.ibb.co/wr2CLVVd/default-poster.png' %>" alt="<%= cls.name %>" />
          <div class="cls-body">
            <div class="cls-name"><%= cls.name %></div>
            <div class="cls-course"><%= cls.idCourse ? cls.idCourse.name : '' %></div>
            <div class="cls-meta">
              <span><i class="fas fa-chalkboard-teacher"></i> <%= cls.idLecturer ? cls.idLecturer.name : '—' %></span>
              <span><i class="fas fa-calendar-alt"></i> <%= cls.sessions.length %> buổi (<%= doneSessions %> đã học)</span>
              <span><i class="fas fa-users"></i> <%= cls.students.length %> học viên</span>
              <span class="cls-badge <%= badgeClass %>"><%= statusLabel %></span>
            </div>
          </div>
          <div class="cls-arrow"><i class="fas fa-chevron-right"></i></div>
        </a>
      </div>
      <% }) %>
    <% } %>
  </div>
</div>

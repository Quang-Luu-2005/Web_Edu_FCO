<style>
.pay-page {
  min-height: calc(100vh - 120px);
  background: #f8f7f4;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 16px;
}
.pay-card {
  width: 100%;
  max-width: 480px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 8px 40px rgba(26,31,46,0.10);
  overflow: hidden;
}
.pay-header {
  background: linear-gradient(90deg, #1a1f2e, #2d3a5e);
  padding: 24px 28px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.pay-poster {
  width: 72px;
  height: 48px;
  border-radius: 8px;
  object-fit: cover;
  flex: 0 0 auto;
}
.pay-course-name {
  font-size: 15px;
  font-weight: 700;
  color: #f1f5f9;
  line-height: 1.4;
}
.pay-body { padding: 24px 28px; }

.pay-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #f0efe9;
  font-size: 14px;
}
.pay-row:last-of-type { border-bottom: none; }
.pay-row-label { color: #718096; }
.pay-row-value { font-weight: 600; color: #1a1f2e; }
.pay-total { font-size: 18px; font-weight: 700; color: #1a1f2e; }
.pay-total-label { font-size: 15px; font-weight: 700; color: #1a1f2e; }

.pay-discount-wrap {
  margin: 16px 0 6px;
  display: flex;
  gap: 8px;
}
.pay-discount-input {
  flex: 1;
  height: 40px;
  padding: 0 14px;
  border: 1.5px solid #e8e8e4;
  border-radius: 8px;
  font-size: 13px;
  color: #1a1f2e;
  outline: none;
  text-transform: uppercase;
  transition: border-color 0.15s;
}
.pay-discount-input:focus { border-color: #3b6fd4; }
.pay-discount-btn {
  height: 40px;
  padding: 0 16px;
  background: #1a1f2e;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s;
  white-space: nowrap;
}
.pay-discount-btn:hover { background: #3b6fd4; }
.pay-discount-msg { font-size: 12px; margin-top: 4px; min-height: 16px; }
.pay-discount-msg.ok  { color: #16a34a; }
.pay-discount-msg.err { color: #dc2626; }

.pay-info-box {
  background: #eff4ff;
  border: 1px solid rgba(59,111,212,0.15);
  border-radius: 10px;
  padding: 14px 16px;
  margin: 16px 0;
  font-size: 13px;
  color: #3b6fd4;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.pay-info-box i { margin-top: 2px; flex: 0 0 auto; }

.pay-submit {
  width: 100%;
  height: 48px;
  background: linear-gradient(90deg, #1a1f2e, #3b6fd4);
  color: #fff;
  border: none;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  transition: opacity 0.15s;
  margin-top: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.pay-submit:hover { opacity: 0.9; }

.pay-terms {
  font-size: 12px;
  color: #9ca3af;
  text-align: center;
  margin-top: 12px;
  line-height: 1.6;
}
</style>

<div class="pay-page">
  <div class="pay-card">
    <div class="pay-header">
      <img class="pay-poster" src="<%= course.poster || 'https://i.ibb.co/wr2CLVVd/default-poster.png' %>" alt="<%= course.name %>" />
      <div>
        <div style="font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px">Đăng ký khóa học</div>
        <div class="pay-course-name"><%= course.name %></div>
      </div>
    </div>

    <div class="pay-body">
      <form action="/payment/<%= encodeURIComponent(course.name) %>/checkout" method="POST" id="payForm">
        <div style="margin-bottom:8px">
          <div class="pay-row">
            <span class="pay-row-label">Giá gốc</span>
            <span class="pay-row-value"><%= (Number(course.tuition) || 0).toLocaleString('vi-VN') %>đ</span>
          </div>
          <div class="pay-row" id="discount-row" style="display:none">
            <span class="pay-row-label">Giảm giá</span>
            <span class="pay-row-value" style="color:#16a34a" id="discount-amount">-0đ</span>
          </div>
          <div class="pay-row">
            <span class="pay-total-label">Tổng thanh toán</span>
            <span class="pay-total" id="total-display"><%= (Number(course.tuition) || 0).toLocaleString('vi-VN') %>đ</span>
          </div>
        </div>

        <% const activeDiscountCodes = (course.discountCodes || []).filter(d => d.active); %>
        <div>
          <div style="font-size:12px;font-weight:600;color:#718096;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px">Mã giảm giá</div>
          <div class="pay-discount-wrap">
            <input type="text" class="pay-discount-input" id="discount-input" name="discountCode" placeholder="Nhập mã..." maxlength="20" oninput="this.value=this.value.toUpperCase()" <%= activeDiscountCodes.length ? '' : 'disabled' %> />
            <button type="button" class="pay-discount-btn" onclick="applyDiscount()" <%= activeDiscountCodes.length ? '' : 'disabled' %>>Áp dụng</button>
          </div>
          <div class="pay-discount-msg <%= activeDiscountCodes.length ? '' : 'err' %>" id="discount-msg"><%= activeDiscountCodes.length ? '' : 'Khóa học này chưa được cấu hình mã giảm giá.' %></div>
        </div>

        <div class="pay-info-box" id="pay-info-box">
          <i class="fas fa-info-circle"></i>
          <div id="pay-info-text">
            Bạn sẽ được chuyển đến trang thanh toán <strong>PayOS</strong> để thực hiện chuyển khoản ngân hàng. Giao dịch được xác minh tự động.
          </div>
        </div>

        <button type="submit" class="pay-submit" id="pay-submit-btn">
          <i class="fas fa-university" id="pay-submit-icon"></i>
          <span id="pay-submit-text">Thanh toán chuyển khoản</span>
        </button>
      </form>

      <p class="pay-terms">
        Khi thanh toán, bạn đồng ý với <a href="#" style="color:#3b6fd4">Điều khoản dịch vụ</a> của chúng tôi.
      </p>
    </div>
  </div>
</div>

<script>
const ORIGINAL_PRICE = <%= Number(course.tuition) || 0 %>;
const DISCOUNTS = <%- JSON.stringify(activeDiscountCodes.map(d => ({
  code: d.code,
  percent: Number(d.percent) || 0,
  maxUses: Number(d.maxUses) || 0,
  usedCount: Number(d.usedCount) || 0,
  expiresAt: d.expiresAt
}))) %>;

function formatVnd(value) {
  return Number(value || 0).toLocaleString('vi-VN') + 'đ';
}

function getDiscountExpiryEnd(value) {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return new Date(0);
  return new Date(Date.UTC(
    date.getUTCFullYear(),
    date.getUTCMonth(),
    date.getUTCDate(),
    16, 59, 59, 999
  ));
}

function applyDiscount() {
  const inputEl = document.getElementById('discount-input');
  const msgEl = document.getElementById('discount-msg');
  const discountRow = document.getElementById('discount-row');
  const discountAmountEl = document.getElementById('discount-amount');
  const totalEl = document.getElementById('total-display');
  const code = inputEl.value.trim().toUpperCase();

  if (!code) {
    msgEl.textContent = 'Vui lòng nhập mã';
    msgEl.className = 'pay-discount-msg err';
    return;
  }

  const discount = DISCOUNTS.find(d => d.code === code);
  if (!discount) {
    msgEl.textContent = 'Mã không hợp lệ';
    msgEl.className = 'pay-discount-msg err';
    discountRow.style.display = 'none';
    totalEl.textContent = formatVnd(ORIGINAL_PRICE);
    updateSubmitButton(ORIGINAL_PRICE);
    return;
  }

  if (discount.expiresAt && new Date() > getDiscountExpiryEnd(discount.expiresAt)) {
    msgEl.textContent = 'Mã đã hết hạn';
    msgEl.className = 'pay-discount-msg err';
    return;
  }

  if (discount.maxUses > 0 && discount.usedCount >= discount.maxUses) {
    msgEl.textContent = 'Mã đã hết lượt sử dụng';
    msgEl.className = 'pay-discount-msg err';
    return;
  }

  const discountAmount = Math.round(ORIGINAL_PRICE * discount.percent / 100);
  const finalAmount = Math.max(0, ORIGINAL_PRICE - discountAmount);

  discountAmountEl.textContent = '-' + formatVnd(discountAmount);
  totalEl.textContent = formatVnd(finalAmount);
  discountRow.style.display = '';
  msgEl.textContent = `Giảm ${discount.percent}% - tiết kiệm ${formatVnd(discountAmount)}`;
  msgEl.className = 'pay-discount-msg ok';
  updateSubmitButton(finalAmount);
}

function updateSubmitButton(finalAmount) {
  const btn = document.getElementById('pay-submit-btn');
  const text = document.getElementById('pay-submit-text');
  const icon = document.getElementById('pay-submit-icon');
  const infoBox = document.getElementById('pay-info-box');
  const infoText = document.getElementById('pay-info-text');

  if (finalAmount === 0) {
    text.textContent = 'Đăng ký miễn phí';
    icon.className = 'fas fa-check-circle';
    btn.style.background = 'linear-gradient(90deg, #16a34a, #22c55e)';
    infoText.innerHTML = '<strong>Mã giảm 100%</strong> - bạn sẽ được đăng ký khóa học miễn phí, không cần thanh toán.';
    infoBox.style.background = '#dcfce7';
    infoBox.style.borderColor = 'rgba(22,163,74,0.25)';
    infoBox.style.color = '#15803d';
  } else {
    text.textContent = 'Thanh toán chuyển khoản';
    icon.className = 'fas fa-university';
    btn.style.background = 'linear-gradient(90deg, #1a1f2e, #3b6fd4)';
    infoText.innerHTML = 'Bạn sẽ được chuyển đến trang thanh toán <strong>PayOS</strong> để thực hiện chuyển khoản ngân hàng. Giao dịch được xác minh tự động.';
    infoBox.style.background = '';
    infoBox.style.borderColor = '';
    infoBox.style.color = '';
  }
}

const discountInput = document.getElementById('discount-input');
if (discountInput) {
  discountInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      applyDiscount();
    }
  });
}
</script>

<style>
.ps-page {
  min-height: calc(100vh - 120px);
  background: #f8f7f4;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 16px;
}
.ps-card {
  width: 100%;
  max-width: 480px;
  background: #fff;
  border-radius: 16px;
  box-shadow: 0 8px 40px rgba(26,31,46,0.10);
  overflow: hidden;
}
.ps-header {
  background: linear-gradient(135deg, #16a34a, #22c55e);
  padding: 36px 28px;
  text-align: center;
  color: #fff;
}
.ps-icon-wrap {
  width: 72px;
  height: 72px;
  background: rgba(255,255,255,0.18);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  font-size: 32px;
  animation: ps-pop 0.5s ease;
}
@keyframes ps-pop {
  from { transform: scale(0.5); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.ps-title { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
.ps-sub { font-size: 14px; opacity: 0.92; }

.ps-body { padding: 28px; }

.ps-course-row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 14px;
  background: #f8f7f4;
  border-radius: 10px;
  margin-bottom: 20px;
}
.ps-poster {
  width: 64px;
  height: 42px;
  border-radius: 6px;
  object-fit: cover;
  flex: 0 0 auto;
}
.ps-course-name { font-size: 14px; font-weight: 700; color: #1a1f2e; }
.ps-course-meta { font-size: 12px; color: #718096; margin-top: 2px; }

.ps-info-box {
  background: #eff4ff;
  border: 1px solid rgba(59,111,212,0.15);
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 20px;
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.ps-info-box i { color: #3b6fd4; margin-top: 2px; flex: 0 0 auto; }
.ps-info-box div { font-size: 13px; color: #4a5568; line-height: 1.6; }

.ps-actions {
  display: flex;
  gap: 10px;
}
.ps-btn {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 44px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition: opacity 0.15s, background 0.15s;
}
.ps-btn-primary {
  background: linear-gradient(90deg, #1a1f2e, #3b6fd4);
  color: #fff;
}
.ps-btn-primary:hover { opacity: 0.9; color: #fff; text-decoration: none; }
.ps-btn-ghost {
  background: transparent;
  color: #3b6fd4;
  border: 1.5px solid #3b6fd4;
}
.ps-btn-ghost:hover { background: #eff4ff; color: #3b6fd4; text-decoration: none; }
</style>

<div class="ps-page">
  <div class="ps-card">
    <div class="ps-header">
      <div class="ps-icon-wrap"><i class="fas fa-check"></i></div>
      <div class="ps-title">Đăng ký thành công!</div>
      <div class="ps-sub">
        <% if (isFree) { %>
          Bạn đã đăng ký miễn phí khóa học này
        <% } else { %>
          Đã thanh toán <%= (Number(amount) || 0).toLocaleString('vi-VN') %>đ thành công
        <% } %>
      </div>
    </div>

    <div class="ps-body">
      <div class="ps-course-row">
        <img class="ps-poster" src="<%= course.poster || 'https://i.ibb.co/wr2CLVVd/default-poster.png' %>" alt="<%= course.name %>" />
        <div style="flex:1;min-width:0">
          <div class="ps-course-name"><%= course.name %></div>
          <div class="ps-course-meta"><%= course.idCourseTopic ? course.idCourseTopic.name : '' %></div>
        </div>
      </div>

      <div class="ps-info-box">
        <i class="fas fa-info-circle"></i>
        <div>
          <strong>Tiếp theo:</strong> quản lý sẽ phân giảng viên và xếp bạn vào lớp học phù hợp. Bạn sẽ nhận được thông báo khi được thêm vào lớp.
        </div>
      </div>

      <div class="ps-actions">
        <a href="/" class="ps-btn ps-btn-ghost">
          <i class="fas fa-home"></i> Trang chủ
        </a>
        <a href="/my-courses" class="ps-btn ps-btn-primary">
          <i class="fas fa-book-open"></i> Khóa học của tôi
        </a>
      </div>
    </div>
  </div>
</div>

<style>
.mc-page {
  min-height: calc(100vh - 120px);
  background: #f8f7f4;
  padding: 40px 0 64px;
}

.mc-wrap {
  width: 85%;
  max-width: 1100px;
  margin: 0 auto;
}

.mc-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
}

.mc-title {
  font-size: 26px;
  font-weight: 700;
  color: #1a1f2e;
}

.mc-count {
  font-size: 14px;
  color: #718096;
  margin-top: 4px;
}

/* ── Table card ── */
.mc-card {
  background: #ffffff;
  border: 1px solid #e8e8e4;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 2px 12px rgba(26,31,46,0.06);
}

.mc-table {
  width: 100%;
  border-collapse: collapse;
}

.mc-table thead th {
  padding: 12px 18px;
  font-size: 11px;
  font-weight: 700;
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  background: #fafaf8;
  border-bottom: 1px solid #eeede8;
  white-space: nowrap;
}

.mc-table tbody tr {
  border-bottom: 1px solid #f0efe9;
  transition: background 0.12s;
}
.mc-table tbody tr:last-child { border-bottom: none; }
.mc-table tbody tr:hover { background: #fafaf8; }

.mc-table tbody td {
  padding: 16px 18px;
  vertical-align: middle;
}

/* ── Course cell ── */
.mc-course-cell {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.mc-poster {
  width: 80px;
  height: 50px;
  border-radius: 8px;
  object-fit: cover;
  flex: 0 0 auto;
  background: #e8e8e4;
}

.mc-course-name {
  font-size: 14px;
  font-weight: 700;
  color: #1a1f2e;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.mc-course-topic {
  font-size: 12px;
  color: #9ca3af;
  margin-top: 2px;
}

/* ── Progress bar ── */
.mc-progress-wrap {
  min-width: 140px;
}

.mc-progress-bar {
  height: 6px;
  background: #e8e8e4;
  border-radius: 999px;
  overflow: hidden;
  margin-bottom: 5px;
}

.mc-progress-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #3b6fd4, #16a34a);
  transition: width 0.4s ease;
}

.mc-progress-text {
  font-size: 12px;
  color: #718096;
  font-weight: 600;
}

/* ── Status badge ── */
.mc-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}

.mc-badge-done {
  background: #dcfce7;
  color: #15803d;
  border: 1px solid #bbf7d0;
}

.mc-badge-learning {
  background: #eff4ff;
  color: #3b6fd4;
  border: 1px solid #c7d7f8;
}

.mc-badge-new {
  background: #fef9ec;
  color: #b45309;
  border: 1px solid #fde68a;
}

/* ── Date cell ── */
.mc-date {
  font-size: 13px;
  color: #4a5568;
  white-space: nowrap;
}

.mc-date-sub {
  font-size: 11px;
  color: #9ca3af;
  margin-top: 2px;
}

/* ── Action button ── */
.mc-btn-go {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  background: #1a1f2e;
  color: #fff;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.15s;
  white-space: nowrap;
}
.mc-btn-go:hover { background: #3b6fd4; color: #fff; text-decoration: none; }

/* ── Empty state ── */
.mc-empty {
  text-align: center;
  padding: 64px 24px;
  color: #9ca3af;
}
.mc-empty-icon { font-size: 48px; margin-bottom: 16px; }
.mc-empty-title { font-size: 18px; font-weight: 700; color: #4a5568; margin-bottom: 8px; }
.mc-empty-sub { font-size: 14px; margin-bottom: 24px; }
.mc-empty-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 22px;
  background: #3b6fd4; color: #fff;
  border-radius: 10px; font-size: 14px; font-weight: 700;
  text-decoration: none; transition: background 0.15s;
}
.mc-empty-btn:hover { background: #2d5ab8; color: #fff; text-decoration: none; }

/* ── Stats row ── */
.mc-stats {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.mc-stat-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: #ffffff;
  border: 1px solid #e8e8e4;
  border-radius: 10px;
  font-size: 13px;
  color: #4a5568;
  box-shadow: 0 1px 4px rgba(26,31,46,0.05);
}
.mc-stat-chip strong { color: #1a1f2e; font-size: 18px; font-weight: 700; }
.mc-stat-chip i { font-size: 16px; }
</style>

<div class="mc-page">
  <div class="mc-wrap">

    <div class="mc-header">
      <div>
        <h1 class="mc-title">Khóa học của tôi</h1>
        <div class="mc-count"><%= items.length %> khóa học đã đăng ký</div>
      </div>
      <a href="/courses" class="mc-btn-go" style="background:#3b6fd4">
        <i class="fas fa-search"></i> Khám phá thêm
      </a>
    </div>

    <% if (items.length > 0) { %>

    <%
      const inClassCnt = items.filter(i => i.classId).length;
      const waitingCnt = items.filter(i => !i.classId).length;
    %>

    <!-- Stats -->
    <div class="mc-stats">
      <div class="mc-stat-chip">
        <i class="fas fa-book-open" style="color:#3b6fd4"></i>
        <span>Tổng: <strong><%= items.length %></strong></span>
      </div>
      <div class="mc-stat-chip">
        <i class="fas fa-chalkboard-teacher" style="color:#16a34a"></i>
        <span>Đã có lớp: <strong><%= inClassCnt %></strong></span>
      </div>
      <% if (waitingCnt > 0) { %>
      <div class="mc-stat-chip">
        <i class="fas fa-clock" style="color:#b45309"></i>
        <span>Chờ xếp lớp: <strong><%= waitingCnt %></strong></span>
      </div>
      <% } %>
    </div>

    <!-- Table -->
    <div class="mc-card">
      <table class="mc-table">
        <thead>
          <tr>
            <th>Khóa học</th>
            <th>Lớp của tôi</th>
            <th>Ngày đăng ký</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => {
            const fmtDate = (d) => {
              if (!d) return '—';
              const dt = new Date(d);
              return dt.toLocaleDateString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric' });
            };
            const fmtTime = (d) => {
              if (!d) return '';
              const dt = new Date(d);
              return dt.toLocaleTimeString('vi-VN', { hour:'2-digit', minute:'2-digit' });
            };
          %>
          <tr>
            <!-- Khóa học -->
            <td>
              <div class="mc-course-cell">
                <img class="mc-poster"
                  src="<%= item.course.poster || 'https://i.ibb.co/wr2CLVVd/default-poster.png' %>"
                  alt="<%= item.course.name %>" />
                <div style="min-width:0">
                  <div class="mc-course-name"><%= item.course.name %></div>
                  <div class="mc-course-topic">
                    <%= item.course.idCourseTopic && item.course.idCourseTopic.name ? item.course.idCourseTopic.name : '' %>
                    <% if (item.course.idLecturer && item.course.idLecturer.name) { %>
                      · <%= item.course.idLecturer.name %>
                    <% } %>
                  </div>
                </div>
              </div>
            </td>

            <!-- Lớp của tôi -->
            <td>
              <% if (item.course.courseType === 'hour') { %>
              <div style="font-size:13px;font-weight:600;color:#1a1f2e"><%= item.totalPurchasedHours %> giờ đã mua</div>
              <div style="font-size:11px;color:#9ca3af;margin-top:2px"><%= item.purchaseCount %> lượt mua</div>
              <% } else if (item.className) { %>
              <div style="font-size:13px;font-weight:600;color:#1a1f2e"><%= item.className %></div>
              <div style="font-size:11px;color:#9ca3af;margin-top:2px"><%= item.totalVideos %> buổi học</div>
              <% } else { %>
              <span style="font-size:12px;color:#b45309;background:#fef9ec;padding:3px 10px;border-radius:20px;border:1px solid #fde68a;font-weight:600">⏳ Chờ xếp lớp</span>
              <% } %>
            </td>

            <!-- Ngày đăng ký -->
            <td>
              <div class="mc-date"><%= fmtDate(item.enrolledAt) %></div>
              <div class="mc-date-sub"><%= fmtTime(item.enrolledAt) %></div>
            </td>

            <!-- Action -->
            <td>
              <% if (item.course.courseType === 'hour') { %>
              <a href="/payment/<%= encodeURIComponent(item.course.name) %>/checkout" class="mc-btn-go">
                <i class="fas fa-plus"></i> Mua thêm giờ
              </a>
              <% } else if (item.canPurchaseAgain) { %>
              <a href="/payment/<%= encodeURIComponent(item.course.name) %>/checkout" class="mc-btn-go">
                <i class="fas fa-redo"></i> Học lại
              </a>
              <% } else if (item.classId) { %>
              <a href="/classes/my-classes/<%= item.classId %>" class="mc-btn-go">
                <i class="fas fa-play"></i> Vào lớp
              </a>
              <% } else { %>
              <span class="mc-btn-go" style="background:#cbd5e1;color:#fff;cursor:not-allowed">
                <i class="fas fa-clock"></i> Chờ xếp lớp
              </span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% } else { %>
    <div class="mc-card">
      <div class="mc-empty">
        <div class="mc-empty-icon">📚</div>
        <div class="mc-empty-title">Bạn chưa có khóa học nào</div>
        <div class="mc-empty-sub">Khám phá hàng trăm khóa học và bắt đầu hành trình học tập ngay hôm nay.</div>
        <a href="/courses" class="mc-empty-btn"><i class="fas fa-search"></i> Khám phá khóa học</a>
      </div>
    </div>
    <% } %>

  </div>
</div>

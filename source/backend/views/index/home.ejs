<div id="body" class="container-wrap">

  <!-- ── Slideshow banner ── -->
  <% if (homeBanners && homeBanners.length > 0) { %>
  <div class="hb-slider" id="hb-slider">
    <div class="hb-track" id="hb-track">
      <% homeBanners.forEach((src, i) => { %>
      <div class="hb-slide <%= i === 0 ? 'active' : '' %>">
        <img src="<%= src %>" alt="Banner <%= i+1 %>" />
      </div>
      <% }) %>
    </div>
    <% if (homeBanners.length > 1) { %>
    <button class="hb-btn hb-prev" onclick="hbPrev()" aria-label="Trước">&#8249;</button>
    <button class="hb-btn hb-next" onclick="hbNext()" aria-label="Tiếp">&#8250;</button>
    <div class="hb-dots" id="hb-dots">
      <% homeBanners.forEach((_, i) => { %>
      <button class="hb-dot <%= i === 0 ? 'active' : '' %>" onclick="hbGo(<%= i %>)"></button>
      <% }) %>
    </div>
    <% } %>
  </div>
  <% } %>

  <div class="section-block">
    <h4 class="section-title">3 khóa học được quan tâm nhất</h4>
    <%- include('../partials/card-course', {courses: proCourses, type: 'proCourse'}) %>
  </div>

  <div class="section-block">
    <h4 class="section-title">10 khóa học được xem nhiều nhất</h4>
    <%- include('../partials/card-course', {courses: mostViewCourses, type: 'mostViewCourse'}) %>
  </div>

  <div class="section-block">
    <h4 class="section-title">10 khóa học mới nhất</h4>
    <%- include('../partials/card-course', {courses: latestCourses, type: 'latestCourse'}) %>
  </div>

  <div class="section-feature">
    <div class="feature-label">⚽ WEBCTT2 mang lại</div>
    <div class="row feature-grid">
      <div class="col-sm-4">
        <div class="feature-card feature-card-cyan">
          <div class="feature-icon">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="32" cy="32" r="28" fill="#dbeafe"/>
              <path d="M20 33l8 8 16-16" stroke="#3b6fd4" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="32" cy="32" r="20" stroke="#3b6fd4" stroke-width="2.5" stroke-dasharray="4 3"/>
            </svg>
          </div>
          <div>
            <h3>Chất lượng uy tín</h3>
            <p>Cam kết đồng hành cùng học viên đến khi lên siêu sao, không giới hạn buổi thực hành.</p>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="feature-card feature-card-green">
          <div class="feature-icon">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="32" cy="32" r="28" fill="#dcfce7"/>
              <rect x="16" y="20" width="32" height="22" rx="4" stroke="#16a34a" stroke-width="2.5"/>
              <path d="M24 42v4M40 42v4M20 46h24" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M26 29l4 4 8-8" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <h3>Video đa dạng</h3>
            <p>Luôn có hỗ trợ record video các buổi học, update video chiến thuật đối với meta mới.</p>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="feature-card feature-card-amber">
          <div class="feature-icon">
            <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="32" cy="32" r="28" fill="#fef3c7"/>
              <path d="M32 18v4M32 42v4M18 32h4M42 32h4" stroke="#d97706" stroke-width="2.5" stroke-linecap="round"/>
              <circle cx="32" cy="32" r="8" stroke="#d97706" stroke-width="2.5"/>
              <path d="M28 32l3 3 5-5" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <h3>Chế độ hậu mãi</h3>
            <p>Luôn được hỗ trợ, update meta game liên tục — không bao giờ bị bỏ lại phía sau.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style type="text/css">
  /* ── Slideshow ── */
  .hb-slider {
    position: relative;
    width: 100%;
    max-width: 1580px;
    margin: 20px auto 0;
    border-radius: 10px;
    overflow: hidden;
    background: #e8e8e4;
    aspect-ratio: 8 / 3;
    user-select: none;
  }

  .hb-track { width: 100%; height: 100%; position: relative; }

  .hb-slide {
    position: absolute; inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }
  .hb-slide.active { opacity: 1; pointer-events: auto; }

  .hb-slide img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
  }

  /* Nút prev/next */
  .hb-btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 10;
    width: 40px; height: 40px;
    background: rgba(0,0,0,0.35);
    border: none; border-radius: 50%;
    color: #fff; font-size: 22px; line-height: 1;
    cursor: pointer;
    transition: background 0.15s;
    display: flex; align-items: center; justify-content: center;
  }
  .hb-btn:hover { background: rgba(0,0,0,0.6); }
  .hb-prev { left: 14px; }
  .hb-next { right: 14px; }

  /* Dots */
  .hb-dots {
    position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 6px; z-index: 10;
  }
  .hb-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: rgba(255,255,255,0.45);
    border: none; cursor: pointer; padding: 0;
    transition: background 0.2s, transform 0.2s;
  }
  .hb-dot.active { background: #fff; transform: scale(1.3); }

  .section-block {
    margin-top: 34px;
  }

  .section-title {
    font-family: 'Be Vietnam Pro', 'Segoe UI', Arial, sans-serif;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0;
    color: #1a1f2e;
    margin: 0 0 16px;
    padding-left: 14px;
    border-left: 5px solid #3b6fd4;
    font-size: 24px;
    text-wrap: balance;
  }

  .section-title-large {
    font-size: 22px;
  }

  .course-more-detail {
    display: none;
  }

  .course:hover .course-more-detail {
    display: block;
  }

  .navbar-collapse {
    flex-grow: 0;
  }

  .navbar-collapse-right {
    margin-left: 750px;
  }

  .container-wrap {
    width: 85%;
    margin-left: auto;
    margin-right: auto;
    padding-top: 48px;
  }

  .row.top-section {
    margin-top: 20px;
    align-items: stretch;
  }

  .home-banner {
    overflow: hidden;
    background: #e8e8e4;
    border-radius: 10px;
    position: relative;
  }

  .home-banner img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .home-banner-main {
    height: 380px;
  }

  .home-banner-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 380px;
  }

  .home-banner-sub {
    flex: 1;
    min-height: 0;
  }

  .course .image {
    margin-right: auto;
    margin-left: auto;
    margin-bottom: 10px;
    width: 100%;
  }

  .course {
    margin: 0 10px;
  }

  .section-feature {
    margin: 36px 0 34px;
    padding: 24px 28px 28px;
    border-radius: 14px;
    background: linear-gradient(135deg, #eef2ff 0%, #fdf6ec 50%, #edfaf3 100%);
    border: 1px solid rgba(59,111,212,0.10);
    box-shadow: 0 4px 24px rgba(26,31,46,0.06);
  }

  .feature-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    background: #1a1f2e;
    color: #e2e8f0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .feature-card {
    width: 100%;
    min-height: 200px;
    padding: 22px;
    border-radius: 12px;
    border: 1px solid rgba(26,31,46,0.07);
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(26,31,46,0.07);
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(26,31,46,0.13);
  }

  .feature-card-cyan  { background: linear-gradient(160deg, #ffffff 0%, #eff6ff 100%); }
  .feature-card-amber { background: linear-gradient(160deg, #ffffff 0%, #fffbeb 100%); }
  .feature-card-green { background: linear-gradient(160deg, #ffffff 0%, #f0fdf4 100%); }

  .feature-icon {
    width: 64px;
    height: 64px;
    flex: 0 0 auto;
  }
  .feature-icon svg { width: 100%; height: 100%; display: block; }

  .feature-card h3 {
    margin: 0 0 8px;
    color: #1a1f2e;
    font-size: 18px;
    line-height: 1.3;
  }

  .feature-card p {
    margin: 0;
    color: #4a5568;
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 767px) {
    .section-feature {
      padding: 20px;
    }

    .feature-grid {
      display: block;
    }

    .feature-card {
      min-height: 0;
    }
  }

  .footer-container {
    padding-top: 30px;
    padding-bottom: 20px;
    font-size: 13px;
    text-align: center;
  }

  .footer-container {
    font-size: 15px;
    background: #1a1f2e;
    color: #94a3b8;
    letter-spacing: 0.2px;
  }

</style>

<script>
  // ── Slideshow banner ──
  (function() {
    const slides = document.querySelectorAll('.hb-slide');
    const dots   = document.querySelectorAll('.hb-dot');
    if (!slides.length) return;
    let cur = 0, timer = null;

    function go(n) {
      slides[cur].classList.remove('active');
      dots[cur] && dots[cur].classList.remove('active');
      cur = (n + slides.length) % slides.length;
      slides[cur].classList.add('active');
      dots[cur] && dots[cur].classList.add('active');
    }

    function start() { timer = setInterval(() => go(cur + 1), 4000); }
    function reset()  { clearInterval(timer); start(); }

    window.hbNext = () => { go(cur + 1); reset(); };
    window.hbPrev = () => { go(cur - 1); reset(); };
    window.hbGo   = (n) => { go(n); reset(); };

    // Swipe support
    const slider = document.getElementById('hb-slider');
    if (slider) {
      let sx = 0;
      slider.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
      slider.addEventListener('touchend',   e => {
        const dx = e.changedTouches[0].clientX - sx;
        if (Math.abs(dx) > 40) { dx < 0 ? hbNext() : hbPrev(); }
      });
    }

    if (slides.length > 1) start();
  })();

  document.querySelectorAll("[data-course-carousel]").forEach((carousel) => {
    const track  = carousel.querySelector(".course-carousel-track");
    const prev   = carousel.querySelector("[data-course-carousel-prev]");
    const next   = carousel.querySelector("[data-course-carousel-next]");
    const sbWrap = carousel.querySelector("[data-course-carousel-scrollbar]");
    const thumb  = carousel.querySelector("[data-course-carousel-thumb]");

    if (!track) return;

    /* ── Scrollbar tùy chỉnh ── */
    const updateThumb = () => {
      if (!sbWrap || !thumb) return;
      const ratio      = track.clientWidth / track.scrollWidth;
      const thumbW     = Math.max(ratio * sbWrap.clientWidth, 40);
      const maxLeft    = sbWrap.clientWidth - thumbW;
      const scrollRatio = track.scrollLeft / (track.scrollWidth - track.clientWidth || 1);
      thumb.style.width = thumbW + "px";
      thumb.style.left  = scrollRatio * maxLeft + "px";
    };

    /* Kéo thumb */
    if (thumb && sbWrap) {
      let dragging = false, startX = 0, startLeft = 0;
      thumb.addEventListener("mousedown", (e) => {
        dragging = true; startX = e.clientX;
        startLeft = parseFloat(thumb.style.left) || 0;
        e.preventDefault();
      });
      document.addEventListener("mousemove", (e) => {
        if (!dragging) return;
        const maxLeft = sbWrap.clientWidth - thumb.offsetWidth;
        const newLeft = Math.min(Math.max(startLeft + e.clientX - startX, 0), maxLeft);
        track.scrollLeft = (newLeft / (maxLeft || 1)) * (track.scrollWidth - track.clientWidth);
      });
      document.addEventListener("mouseup", () => { dragging = false; });

      /* Click vào track scrollbar */
      sbWrap.addEventListener("click", (e) => {
        if (e.target === thumb) return;
        const rect    = sbWrap.getBoundingClientRect();
        const maxLeft = sbWrap.clientWidth - thumb.offsetWidth;
        const ratio   = Math.min(Math.max((e.clientX - rect.left - thumb.offsetWidth / 2) / (maxLeft || 1), 0), 1);
        track.scrollLeft = ratio * (track.scrollWidth - track.clientWidth);
      });
    }

    /* ── Nút prev / next — scroll đúng số card vừa hiển thị ── */
    const getPageWidth = () => {
      const card = track.querySelector(".course-node-link");
      if (!card) return track.clientWidth;
      const cardW = card.offsetWidth + 24; // 24 = gap
      const visibleCount = Math.floor(track.clientWidth / cardW);
      return Math.max(visibleCount, 1) * cardW;
    };

    const syncBtns = () => {
      if (!prev || !next) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= maxScroll - 4;
    };

    if (prev) prev.addEventListener("click", () => track.scrollBy({ left: -getPageWidth(), behavior: "smooth" }));
    if (next) next.addEventListener("click", () => track.scrollBy({ left:  getPageWidth(), behavior: "smooth" }));

    track.addEventListener("scroll", () => { syncBtns(); updateThumb(); });
    window.addEventListener("resize", () => { syncBtns(); updateThumb(); });

    syncBtns();
    updateThumb();
  });
</script>

PORT=8000
APP_URL=http://localhost:8000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

# Session
SESSION_SECRET=your_session_secret

# Google OAuth2 (Login)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/users/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Mail sender option 1: Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
MAIL_FROM=your_sender_gmail@gmail.com

# Mail sender option 2: Gmail OAuth2
GOOGLE_MAIL_CLIENT_ID=your_google_mail_client_id
GOOGLE_MAIL_CLIENT_SECRET=your_google_mail_client_secret
GOOGLE_MAIL_REFRESH_TOKEN=your_google_mail_refresh_token
GOOGLE_MAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_MAIL_USER=your_sender_gmail@gmail.com

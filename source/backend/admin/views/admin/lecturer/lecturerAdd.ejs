<% const activePage = 'lecturers'; const pageTitle = 'Thêm giảng viên'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Thêm giảng viên mới</div>
    <div class="adm-page-subtitle"><a href="/admin/lecturer/lecturersList" style="color:#2563eb">← Quay lại danh sách</a></div>
  </div>
</div>

<form action="" method="post" id="frmAdd">
  <div class="adm-card" style="max-width:680px">
    <div class="adm-card-header">
      <span class="adm-card-title"><i class="fas fa-user-plus" style="color:#16a34a;margin-right:8px"></i>Thông tin giảng viên</span>
    </div>
    <div class="adm-card-body">
      <div class="adm-form-grid">
        <div class="adm-field">
          <label>Tên giảng viên <span style="color:#f87171">*</span></label>
          <input type="text" name="name" placeholder="Nhập tên" required />
        </div>
        <div class="adm-field">
          <label>Email <span style="color:#f87171">*</span></label>
          <input type="email" name="email" placeholder="email@example.com" required />
        </div>
        <div class="adm-field">
          <label>Mật khẩu <span style="color:#f87171">*</span></label>
          <input type="password" name="password" placeholder="••••••••" required autocomplete="new-password" />
        </div>
        <div class="adm-field">
          <label>Giới tính</label>
          <select name="gender">
            <option value="male">Nam</option>
            <option value="female">Nữ</option>
            <option value="other">Khác</option>
          </select>
        </div>
        <div class="adm-field">
          <label>Trạng thái</label>
          <select name="status">
            <option value="1">Hoạt động</option>
            <option value="0">Bị khóa</option>
          </select>
        </div>
        <div class="adm-field adm-field-full">
          <label>Mô tả</label>
          <textarea name="description" placeholder="Giới thiệu về giảng viên..."></textarea>
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.07)">
        <button type="button" class="adm-btn adm-btn-ghost" onclick="location.href='/admin/lecturer/lecturersList'">Huỷ</button>
        <button type="submit" class="adm-btn adm-btn-success"><i class="fas fa-plus"></i> Tạo giảng viên</button>
      </div>
    </div>
  </div>
</form>

<%- include('../common/footer') %>

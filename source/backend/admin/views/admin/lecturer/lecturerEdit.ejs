<% const activePage = 'lecturers'; const pageTitle = 'Chỉnh sửa giảng viên'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Chỉnh sửa giảng viên</div>
    <div class="adm-page-subtitle"><a href="/admin/lecturer/lecturersList" style="color:#2563eb">← Quay lại danh sách</a></div>
  </div>
</div>

<% if (data.Lecturer_info) { %>
<form action="" method="post" id="frmLecturer">
  <input type="hidden" name="id" value="<%= data.Lecturer_info._id %>" />

  <div class="adm-card" style="max-width:680px">
    <div class="adm-card-header">
      <span class="adm-card-title"><i class="fas fa-user-edit" style="color:#2563eb;margin-right:8px"></i>Thông tin giảng viên</span>
    </div>
    <div class="adm-card-body">

      <!-- Avatar -->
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,0.07)">
        <img id="avatar-img" src="<%= data.Lecturer_info.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>"
          style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:2px solid #2563eb;cursor:pointer"
          title="Nhấp để đổi ảnh" onclick="$('#file').click()" />
        <div>
          <div style="font-size:13px;color:#94a3b8;margin-bottom:6px">Nhấp vào ảnh để thay đổi</div>
          <input type="file" id="file" style="display:none" accept="image/*" />
          <input type="hidden" name="avatar" id="avatar" value="<%= data.Lecturer_info.avatar %>" />
        </div>
      </div>

      <div class="adm-form-grid">
        <div class="adm-field">
          <label>Tên giảng viên</label>
          <input type="text" name="name" value="<%= data.Lecturer_info.name %>" placeholder="Nhập tên" />
        </div>
        <div class="adm-field">
          <label>Giới tính</label>
          <select name="gender">
            <option value="male"   <%= data.Lecturer_info.gender === 'male'   ? 'selected' : '' %>>Nam</option>
            <option value="female" <%= data.Lecturer_info.gender === 'female' ? 'selected' : '' %>>Nữ</option>
            <option value="other"  <%= !['male','female'].includes(data.Lecturer_info.gender) ? 'selected' : '' %>>Khác</option>
          </select>
        </div>
        <div class="adm-field">
          <label>Trạng thái</label>
          <select name="status">
            <option value="1" <%= data.Lecturer_info.status ? 'selected' : '' %>>Hoạt động</option>
            <option value="0" <%= !data.Lecturer_info.status ? 'selected' : '' %>>Bị khóa</option>
          </select>
        </div>
        <div class="adm-field adm-field-full">
          <label>Mô tả</label>
          <textarea name="description"><%= data.Lecturer_info.description || '' %></textarea>
        </div>
        <div class="adm-field">
          <label>Mật khẩu mới <span style="color:#64748b;font-weight:400;text-transform:none">(để trống nếu không đổi)</span></label>
          <input type="password" name="password" placeholder="••••••••" autocomplete="new-password" />
        </div>
        <div class="adm-field">
          <label>Xác nhận mật khẩu</label>
          <input type="password" name="confirm" placeholder="••••••••" autocomplete="new-password" />
        </div>
      </div>

      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.07)">
        <button type="button" class="adm-btn adm-btn-ghost" onclick="location.href='/admin/lecturer/lecturersList'">Huỷ</button>
        <button type="submit" class="adm-btn adm-btn-primary"><i class="fas fa-save"></i> Lưu thay đổi</button>
      </div>
    </div>
  </div>
</form>
<% } else { %>
  <div class="adm-empty"><i class="fas fa-exclamation-circle"></i><p>Không tìm thấy giảng viên</p></div>
<% } %>

<script>
$('#file').on('change', function() {
  const fd = new FormData();
  const files = this.files;
  const id = $("input[name='id']").val();
  if (!files.length) return;
  fd.append('file', files[0]);
  $.ajax({
    url: '/admin/upload?id=' + id + '&folder=/image/lecturer/',
    type: 'post', data: fd, contentType: false, processData: false,
    success: res => {
      if (res) { $('#avatar-img').attr('src', res + '?t=' + Date.now()); $('#avatar').val(res); admToast('Ảnh đã cập nhật', 'success'); }
    }
  });
});

$('#frmLecturer').on('submit', function(e) {
  const pw = $("input[name='password']").val();
  const cf = $("input[name='confirm']").val();
  if (pw && pw !== cf) { e.preventDefault(); admToast('Mật khẩu không khớp', 'error'); }
});
</script>

<%- include('../common/footer') %>

<% const activePage = 'lecturers'; const pageTitle = 'Giảng viên'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Danh sách giảng viên</div>
    <div class="adm-page-subtitle"><%= data.Lecturers ? data.Lecturers.length : 0 %> giảng viên</div>
  </div>
  <button class="adm-btn adm-btn-primary" onclick="location.href='/admin/lecturer/lecturerAdd'">
    <i class="fas fa-plus"></i> Thêm giảng viên
  </button>
</div>

<div class="adm-card">
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Giảng viên</th>
          <th>Email</th>
          <th>Giới tính</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (data.Lecturers && data.Lecturers.length > 0) { %>
          <% data.Lecturers.forEach(lec => { %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <img class="adm-avatar" src="<%= lec.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>" alt="avatar" />
                <span style="font-weight:600;color:#f1f5f9"><%= lec.name %></span>
              </div>
            </td>
            <td style="color:#94a3b8"><%= lec.email %></td>
            <td><%= lec.gender === 'male' ? 'Nam' : lec.gender === 'female' ? 'Nữ' : lec.gender || '—' %></td>
            <td>
              <span class="adm-badge <%= lec.status ? 'adm-badge-green' : 'adm-badge-red' %>">
                <%= lec.status ? 'Hoạt động' : 'Bị khóa' %>
              </span>
            </td>
            <td>
              <div style="display:flex;gap:6px">
                <input type="hidden" value="<%= lec._id %>">
                <button class="adm-btn adm-btn-primary adm-btn-sm adm-btn-icon viewLecturer" title="Chỉnh sửa">
                  <i class="fas fa-pen"></i>
                </button>
                <button class="adm-btn adm-btn-danger adm-btn-sm adm-btn-icon deleteLecturer" title="Xóa">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5">
            <div class="adm-empty"><i class="fas fa-chalkboard-teacher"></i><p>Chưa có giảng viên nào</p></div>
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
$('.viewLecturer').on('click', function() {
  const id = $(this).closest('tr').find('input[type=hidden]').val();
  location.href = '/admin/lecturer/lecturerEdit?id=' + id;
});
$('.deleteLecturer').on('click', function() {
  const id = $(this).closest('tr').find('input[type=hidden]').val();
  const row = $(this).closest('tr');
  admConfirm('Xóa giảng viên này?', () => {
    $.getJSON('/admin/lecturer/lecturerDelete?id=' + id, json => {
      if (json === true) { row.fadeOut(300, () => row.remove()); admToast('Đã xóa giảng viên', 'success'); }
      else admToast('Xóa thất bại', 'error');
    });
  }, '🗑️');
});
</script>

<%- include('../common/footer') %>

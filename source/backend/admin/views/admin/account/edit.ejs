<% const activePage = 'account'; const pageTitle = 'Hồ sơ'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div class="adm-page-title">Hồ sơ tài khoản</div>
</div>

<form action="/admin/account/edit" method="post" id="frmAccount">
  <div class="adm-card" style="max-width:680px">
    <div class="adm-card-header">
      <span class="adm-card-title"><i class="fas fa-user-cog" style="color:#2563eb;margin-right:8px"></i>Thông tin cá nhân</span>
    </div>
    <div class="adm-card-body">

      <!-- Avatar -->
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,0.07)">
        <img id="avatar-img" src="<%= user.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>"
          style="width:80px;height:80px;border-radius:50%;object-fit:cover;border:2px solid #2563eb;cursor:pointer"
          title="Nhấp để đổi ảnh" onclick="$('#file').click()" />
        <div>
          <div style="font-size:15px;font-weight:700;color:#f1f5f9"><%= user.name %></div>
          <div style="font-size:13px;color:#64748b"><%= user.email %></div>
          <div style="font-size:12px;color:#2563eb;margin-top:4px;cursor:pointer" onclick="$('#file').click()">Đổi ảnh đại diện</div>
        </div>
        <input type="file" id="file" style="display:none" accept="image/*" />
        <input type="hidden" name="avatar" id="avatar" value="<%= user.avatar %>" />
        <input type="hidden" name="id" value="<%= user._id %>" />
      </div>

      <div class="adm-form-grid">
        <div class="adm-field">
          <label>Tên hiển thị</label>
          <input type="text" name="name" value="<%= user.name %>" />
        </div>
        <div class="adm-field">
          <label>Giới tính</label>
          <select name="gender">
            <option value="male"   <%= user.gender === 'male'   ? 'selected' : '' %>>Nam</option>
            <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Nữ</option>
            <option value="other"  <%= !['male','female'].includes(user.gender) ? 'selected' : '' %>>Khác</option>
          </select>
        </div>
        <% if (user.role !== 'admin') { %>
        <div class="adm-field adm-field-full">
          <label>Mô tả</label>
          <textarea name="description"><%= user.description || '' %></textarea>
        </div>
        <% } %>
        <div class="adm-field">
          <label>Mật khẩu mới <span style="color:#64748b;font-weight:400;text-transform:none">(để trống nếu không đổi)</span></label>
          <input type="password" name="password" placeholder="••••••••" autocomplete="new-password" />
        </div>
        <div class="adm-field">
          <label>Xác nhận mật khẩu</label>
          <input type="password" name="confirm" placeholder="••••••••" autocomplete="new-password" />
        </div>
      </div>

      <div style="display:flex;justify-content:flex-end;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.07)">
        <button type="submit" class="adm-btn adm-btn-primary"><i class="fas fa-save"></i> Lưu thay đổi</button>
      </div>
    </div>
  </div>
</form>

<script>
$('#file').on('change', function() {
  const fd = new FormData();
  const files = this.files;
  const id = $("input[name='id']").val();
  if (!files.length) return;
  fd.append('file', files[0]);
  $.ajax({
    url: '/admin/upload?id=' + id + '&folder=/image/admin/',
    type: 'post', data: fd, contentType: false, processData: false,
    success: res => {
      if (res) { $('#avatar-img').attr('src', res + '?t=' + Date.now()); $('#avatar').val(res); admToast('Ảnh đã cập nhật', 'success'); }
    }
  });
});
$('#frmAccount').on('submit', function(e) {
  const pw = $("input[name='password']").val();
  const cf = $("input[name='confirm']").val();
  if (pw && pw !== cf) { e.preventDefault(); admToast('Mật khẩu không khớp', 'error'); }
});
</script>

<%- include('../common/footer') %>

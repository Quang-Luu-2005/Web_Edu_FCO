<% const activePage = 'classes'; const pageTitle = 'Lớp học'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Lớp học</div>
    <div class="adm-page-subtitle"><%= data.classes.length %> lớp</div>
  </div>
  <button class="adm-btn adm-btn-primary" onclick="location.href='/admin/classes/new'">
    <i class="fas fa-plus"></i> Tạo lớp mới
  </button>
</div>

<!-- Filter -->
<div class="adm-card" style="margin-bottom:16px">
  <div style="display:flex;align-items:center;gap:10px;padding:12px 20px">
    <div style="position:relative;flex:1;max-width:280px">
      <select id="course-filter" onchange="location.href='/admin/classes?courseId='+this.value"
        style="width:100%;height:38px;padding:0 28px 0 12px;background:#0f172a;border:1px solid rgba(255,255,255,0.10);border-radius:8px;color:#e2e8f0;font-size:13px;font-family:inherit;outline:none;appearance:none;-webkit-appearance:none;box-sizing:border-box">
        <option value="">Tất cả khóa học</option>
        <% data.courses.forEach(c => { %>
          <option value="<%= c._id %>" <%= data.courseFilter === c._id.toString() ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
      <span style="position:absolute;right:10px;top:50%;transform:translateY(-50%);pointer-events:none;color:#64748b;font-size:9px">▼</span>
    </div>
  </div>
</div>

<div class="adm-card">
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Tên lớp</th>
          <th>Khóa học</th>
          <th>Giảng viên</th>
          <th>Học viên</th>
          <th>Buổi học</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (data.classes.length > 0) { %>
          <% data.classes.forEach(cls => { %>
          <tr>
            <td style="font-weight:600;color:#f1f5f9"><%= cls.name %></td>
            <td style="color:#94a3b8"><%= cls.idCourse ? cls.idCourse.name : '—' %></td>
            <td style="color:#94a3b8"><%= cls.idLecturer ? cls.idLecturer.name : '—' %></td>
            <td><%= cls.students.length %>/<%= cls.maxStudents %></td>
            <td><%= cls.sessions.length %> buổi</td>
            <td>
              <%
                const statusMap = { open:'Đang hoạt động', ongoing:'Đang học', completed:'Hoàn thành', cancelled:'Đã hủy' };
                const statusColor = { open:'adm-badge-blue', ongoing:'adm-badge-green', completed:'adm-badge-yellow', cancelled:'adm-badge-red' };
              %>
              <span class="adm-badge <%= statusColor[cls.status] || 'adm-badge-blue' %>">
                <%= statusMap[cls.status] || cls.status %>
              </span>
            </td>
            <td>
              <button class="adm-btn adm-btn-primary adm-btn-sm adm-btn-icon" onclick="location.href='/admin/classes/<%= cls._id %>'" title="Xem chi tiết">
                <i class="fas fa-eye"></i>
              </button>
              <button class="adm-btn adm-btn-danger adm-btn-sm adm-btn-icon" onclick="deleteClass('<%= cls._id %>')" title="Xóa lớp" style="margin-left:4px">
                <i class="fas fa-trash"></i>
              </button>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="7">
            <div class="adm-empty"><i class="fas fa-chalkboard"></i><p>Chưa có lớp học nào</p></div>
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function deleteClass(id) {
  admConfirm('Xóa lớp học này?', async () => {
    const res = await fetch('/admin/classes/' + id + '/delete', { method: 'POST' });
    const json = await res.json();
    if (json.ok) { admToast('Đã xóa lớp', 'success'); setTimeout(() => location.reload(), 600); }
    else admToast('Lỗi', 'error');
  }, '🗑️');
}
</script>

<%- include('../common/footer') %>

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MansterClass Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/public/css/admin.css" />
  <link rel="shortcut icon" href="https://i.ibb.co/69L9ymq/image-removebg-preview.png" />
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body>
<div class="adm-shell">

  <!-- ── Sidebar ── -->
  <aside class="adm-sidebar" id="adm-sidebar">
    <div class="adm-sidebar-logo">
      <div class="logo-icon">⚽</div>
      <div>
        <div class="logo-text">MansterClass</div>
        <div class="logo-sub">Admin Panel</div>
      </div>
    </div>

    <nav class="adm-nav">
      <% if (user.role === 'admin') { %>
      <div class="adm-nav-section">Tổng quan</div>
      <a href="/admin/course/coursesList" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'courses' ? 'active' : '' %>">
        <i class="fas fa-book-open"></i> Khóa học
      </a>
      <a href="/admin/users" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'users' ? 'active' : '' %>">
        <i class="fas fa-users"></i> Người dùng
      </a>
      <a href="/admin/classes" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'classes' ? 'active' : '' %>">
        <i class="fas fa-chalkboard"></i> Lớp học
      </a>
      <a href="/admin/practice" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'practice' ? 'active' : '' %>">
        <i class="fas fa-futbol"></i> Lớp thực hành
      </a>
      <a href="/admin/verifications" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'verifications' ? 'active' : '' %>">
        <i class="fas fa-id-card-alt"></i> Xác nhận
      </a>
      <a href="/admin/support" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'support' ? 'active' : '' %>">
        <i class="fas fa-headset"></i> H&#7895; tr&#7907;
        <span class="adm-nav-badge" id="support-unread-badge" style="display:none"></span>
      </a>

      <div class="adm-nav-section" style="margin-top:8px">Cấu hình</div>
      <a href="/admin/home/banners" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'banners' ? 'active' : '' %>">
        <i class="fas fa-images"></i> Banner
      </a>
      <% } else { %>
      <div class="adm-nav-section">Quản lý</div>
      <a href="/admin/course/coursesList" class="adm-nav-item <%= typeof activePage !== 'undefined' && activePage === 'courses' ? 'active' : '' %>">
        <i class="fas fa-book-open"></i> Khóa học của tôi
      </a>
      <% } %>

    </nav>

    <div class="adm-sidebar-footer">
      <div class="adm-user-chip">
        <img class="adm-user-avatar" src="<%= user.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>" alt="avatar" />
        <div class="adm-user-info">
          <div class="adm-user-name"><%= user.name || user.email %></div>
          <div class="adm-user-role"><%= user.role === 'admin' ? 'Quản lý' : 'Giảng viên' %></div>
        </div>
        <a href="/admin/logout" class="adm-logout-btn" title="Đăng xuất">
          <i class="fas fa-sign-out-alt"></i>
        </a>
      </div>
    </div>
  </aside>

  <!-- ── Main ── -->
  <div class="adm-main">
    <header class="adm-topbar">
      <span class="adm-topbar-title" id="adm-topbar-title">
        <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Dashboard' %>
      </span>
      <div class="adm-topbar-actions" id="adm-topbar-actions">
        <!-- injected per page -->
      </div>
    </header>
    <div class="adm-content">
      <% if (user.role === 'admin') { %>
      <script>
      document.addEventListener('DOMContentLoaded', async function () {
        const badge = document.getElementById('support-unread-badge');
        if (!badge) return;
        try {
          const res = await fetch('/admin/support/unread-count', { credentials: 'same-origin' });
          const json = await res.json();
          const count = Number(json.count) || 0;
          if (count > 0) {
            badge.textContent = count > 99 ? '99+' : count;
            badge.style.display = 'inline-flex';
          }
        } catch (e) {}
      });
      </script>
      <% } %>

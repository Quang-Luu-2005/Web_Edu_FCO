<% const activePage = 'courses'; const pageTitle = 'Học viên khóa học'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title"><%= data.course.name %></div>
    <div class="adm-page-subtitle">
      <a href="/admin/course/coursesList" style="color:#2563eb">← Danh sách khóa học</a>
      &nbsp;·&nbsp; <%= data.students.length %> học viên đã đăng ký
    </div>
  </div>
  <button class="adm-btn adm-btn-primary" onclick="location.href='/admin/classes/new?courseId=<%= data.course._id %>'">
    <i class="fas fa-plus"></i> Tạo lớp mới
  </button>
</div>

<!-- Học viên chưa được xếp lớp -->
<div class="adm-card" style="margin-bottom:16px">
  <div class="adm-card-header">
    <span class="adm-card-title">
      <i class="fas fa-user-clock" style="color:#d97706;margin-right:8px"></i>
      Học viên chưa được xếp lớp (<%= data.unassigned.length %>)
    </span>
  </div>
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead><tr><th>Học viên</th><th>Email</th><th>Ngày đăng ký</th><th>Thao tác</th></tr></thead>
      <tbody>
        <% if (data.unassigned.length > 0) { %>
          <% data.unassigned.forEach(s => { %>
          <tr id="un-<%= s.user._id %>">
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <img class="adm-avatar" src="<%= s.user.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>" />
                <span style="font-weight:600;color:#f1f5f9"><%= s.user.name || s.user.username %></span>
              </div>
            </td>
            <td style="color:#94a3b8"><%= s.user.email %></td>
            <td style="color:#64748b;font-size:12px">
              <%= s.enrolledAt ? new Date(s.enrolledAt).toLocaleDateString('vi-VN') : '—' %>
              <% if (s.pendingClassSlots > 1) { %>
                <div style="color:#fbbf24;margin-top:3px;font-weight:700"><%= s.pendingClassSlots %> lượt chờ xếp</div>
              <% } %>
            </td>
            <td>
              <button class="adm-btn adm-btn-primary adm-btn-sm" onclick="openAssignModal('<%= s.user._id %>', '<%= (s.user.name || s.user.username).replace(/'/g, '') %>')">
                <i class="fas fa-user-plus"></i> Xếp lớp
              </button>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="4">
            <div class="adm-empty"><i class="fas fa-check-circle" style="color:#16a34a"></i><p>Tất cả học viên đã được xếp lớp 🎉</p></div>
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Các lớp đang có -->
<div class="adm-card">
  <div class="adm-card-header">
    <span class="adm-card-title">
      <i class="fas fa-chalkboard" style="color:#2563eb;margin-right:8px"></i>
      Các lớp của khóa học này (<%= data.classes.length %>)
    </span>
  </div>
  <div class="adm-card-body">
    <% if (data.classes.length === 0) { %>
      <div class="adm-empty"><i class="fas fa-chalkboard"></i><p>Chưa có lớp nào. Nhấn "+ Tạo lớp mới" để bắt đầu.</p></div>
    <% } else { %>
      <div style="display:flex;flex-direction:column;gap:10px">
        <% data.classes.forEach(cls => { %>
        <div style="background:#0f172a;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:14px;display:flex;align-items:center;gap:14px">
          <div style="flex:1;min-width:0">
            <div style="font-size:14px;font-weight:700;color:#f1f5f9;margin-bottom:3px"><%= cls.name %></div>
            <div style="font-size:12px;color:#64748b">
              <i class="fas fa-chalkboard-teacher"></i> <%= cls.idLecturer ? cls.idLecturer.name : '—' %>
              &nbsp;·&nbsp;
              <i class="fas fa-users"></i> <%= cls.students.length %>/<%= cls.maxStudents %>
              &nbsp;·&nbsp;
              <i class="fas fa-calendar-alt"></i> <%= cls.sessions.length %> buổi
            </div>
          </div>
          <%
            const statusMap = { open:'Đang hoạt động', ongoing:'Đang học', completed:'Hoàn thành', cancelled:'Đã hủy' };
            const statusColor = { open:'adm-badge-blue', ongoing:'adm-badge-green', completed:'adm-badge-yellow', cancelled:'adm-badge-red' };
          %>
          <span class="adm-badge <%= statusColor[cls.status] || 'adm-badge-blue' %>"><%= statusMap[cls.status] %></span>
          <button class="adm-btn adm-btn-ghost adm-btn-sm" onclick="location.href='/admin/classes/<%= cls._id %>'">
            <i class="fas fa-arrow-right"></i> Vào lớp
          </button>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal xếp lớp -->
<div class="modal-overlay" id="assign-modal">
  <div class="modal-box">
    <button class="modal-close" onclick="closeAssign()">&times;</button>
    <h2 class="modal-title"><i class="fas fa-user-plus" style="color:#2563eb"></i> Xếp lớp cho học viên</h2>
    <p style="font-size:13px;color:#94a3b8;margin:0 0 16px">Học viên: <strong id="assign-user-name" style="color:#f1f5f9"></strong></p>
    <div class="adm-field" style="margin-bottom:16px">
      <label>Chọn lớp</label>
      <div style="position:relative">
        <select id="assign-class-select" style="width:100%;height:42px;padding:0 32px 0 14px;background:#0f172a;border:1.5px solid rgba(255,255,255,0.10);border-radius:10px;color:#e2e8f0;font-size:13px;font-family:inherit;outline:none;appearance:none;-webkit-appearance:none;box-sizing:border-box">
          <option value="">-- Chọn lớp --</option>
          <% data.classes.filter(c => c.status !== 'cancelled' && c.status !== 'completed').forEach(cls => { %>
            <option value="<%= cls._id %>" <%= cls.students.length >= cls.maxStudents ? 'disabled' : '' %>>
              <%= cls.name %> (<%= cls.students.length %>/<%= cls.maxStudents %>)
              <%= cls.students.length >= cls.maxStudents ? ' — Đầy' : '' %>
            </option>
          <% }) %>
        </select>
        <span style="position:absolute;right:12px;top:50%;transform:translateY(-50%);pointer-events:none;color:#64748b;font-size:9px">▼</span>
      </div>
    </div>
    <div class="modal-error" id="assign-error" style="font-size:13px;color:#f87171;margin-top:8px;min-height:18px"></div>
    <div class="modal-footer-row">
      <span></span>
      <button class="modal-submit" id="assign-btn" onclick="confirmAssign()">Xếp lớp</button>
    </div>
  </div>
</div>

<style>
.modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px); }
.modal-overlay.open { display:flex; }
.modal-box { background:#1e293b; border:1px solid rgba(255,255,255,0.10); border-radius:16px; padding:28px; width:100%; max-width:440px; box-shadow:0 24px 60px rgba(0,0,0,0.5); position:relative; }
.modal-title { font-size:16px; font-weight:700; color:#f1f5f9; margin:0 0 16px; display:flex; align-items:center; gap:8px; }
.modal-close { position:absolute; top:14px; right:14px; background:none; border:none; color:#64748b; font-size:20px; cursor:pointer; }
.modal-close:hover { color:#f1f5f9; }
.modal-submit { height:38px; padding:0 22px; background:#2563eb; color:#fff; border:none; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer; }
.modal-submit:hover { background:#1d4ed8; }
.modal-footer-row { display:flex; justify-content:space-between; align-items:center; margin-top:12px; }
</style>

<script>
let _assignUserId = null;

function openAssignModal(userId, userName) {
  _assignUserId = userId;
  document.getElementById('assign-user-name').textContent = userName;
  document.getElementById('assign-class-select').value = '';
  document.getElementById('assign-error').textContent = '';
  document.getElementById('assign-modal').classList.add('open');
}

function closeAssign() {
  document.getElementById('assign-modal').classList.remove('open');
}

async function confirmAssign() {
  const classId = document.getElementById('assign-class-select').value;
  const errEl = document.getElementById('assign-error');
  if (!classId) { errEl.textContent = 'Vui lòng chọn lớp'; return; }

  const btn = document.getElementById('assign-btn');
  btn.disabled = true; btn.textContent = 'Đang xếp...';

  try {
    // Lấy email của user cần thêm
    const userId = _assignUserId;
    const res = await fetch('/admin/classes/' + classId + '/students/add-by-id', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId })
    });
    const json = await res.json();
    if (json.ok) {
      admToast('✓ Đã xếp học viên vào lớp', 'success');
      // Xóa row khỏi danh sách chưa xếp
      document.getElementById('un-' + userId)?.remove();
      closeAssign();
      setTimeout(() => location.reload(), 600);
    } else {
      errEl.textContent = '✗ ' + (json.msg || 'Lỗi');
    }
  } catch(e) {
    errEl.textContent = 'Lỗi kết nối';
  } finally {
    btn.disabled = false; btn.textContent = 'Xếp lớp';
  }
}
</script>

<%- include('../common/footer') %>

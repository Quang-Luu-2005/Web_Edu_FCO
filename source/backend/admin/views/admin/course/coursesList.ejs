<% const activePage = 'courses'; const pageTitle = 'Khóa học'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Danh sách khóa học</div>
    <div class="adm-page-subtitle"><%= data.Courses ? data.Courses.length : 0 %> khóa học</div>
  </div>
  <button class="adm-btn adm-btn-primary" onclick="location.href='/admin/course/courseAdd'">
    <i class="fas fa-plus"></i> Thêm khóa học
  </button>
</div>

<div class="adm-card">
  <% if(user.role === 'admin') { %>
  <div class="adm-filter-bar">
    <div class="adm-field">
      <label>Danh mục</label>
      <select name="category_filter" id="category_filter">
        <option value="">Tất cả</option>
        <% data.CourseTopics_array && data.CourseTopics_array.forEach(cat => { %>
          <option value="<%= cat._id %>" <%= data.category_filter && data.category_filter.toString() === cat._id.toString() ? 'selected' : '' %>>
            <%= cat.idCourseCategory.name %> → <%= cat.name %>
          </option>
        <% }) %>
      </select>
    </div>
    <div class="adm-field">
      <label>Giảng viên</label>
      <select name="lecturer_filter" id="lecturer_filter">
        <option value="">Tất cả</option>
        <% data.Lecturers_array && data.Lecturers_array.forEach(lec => { %>
          <option value="<%= lec._id %>" <%= data.lecture_filter && data.lecture_filter.toString() === lec._id.toString() ? 'selected' : '' %>>
            <%= lec.name %>
          </option>
        <% }) %>
      </select>
    </div>
    <button class="adm-btn adm-btn-ghost" onclick="applyFilter()">
      <i class="fas fa-filter"></i> Lọc
    </button>
  </div>
  <% } %>

  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Tên khóa học</th>
          <th>Học sinh</th>
          <th>Trạng thái</th>
          <th>Ngày đăng</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (data.Courses && data.Courses.length > 0) { %>
          <% data.Courses.forEach(course => { %>
          <tr>
            <td style="font-weight:600;color:#f1f5f9"><%= course.name %></td>
            <td><%= course.numberOfStudent || 0 %></td>
            <td>
              <% const done = (course.numberOfVideo || 0) <= (course.videos || []).length; %>
              <span class="adm-badge <%= done ? 'adm-badge-green' : 'adm-badge-yellow' %>">
                <%= done ? 'Hoàn thành' : 'Đang tiến hành' %>
              </span>
            </td>
            <td style="color:#64748b"><%= new Date(course.uploadDate).toLocaleDateString('vi-VN') %></td>
            <td>
              <div class="adm-td-actions" style="display:flex;gap:6px">
                <input type="hidden" value="<%= course._id %>">
                <button class="adm-btn adm-btn-primary adm-btn-sm adm-btn-icon viewCourse" title="Chỉnh sửa">
                  <i class="fas fa-pen"></i>
                </button>
                <button class="adm-btn adm-btn-danger adm-btn-sm adm-btn-icon deleteCourse" title="Xóa">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5">
            <div class="adm-empty"><i class="fas fa-book-open"></i><p>Chưa có khóa học nào</p></div>
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
$('.viewCourse').on('click', function() {
  const id = $(this).closest('tr').find('input[type=hidden]').val();
  location.href = '/admin/course/courseEdit?id=' + id;
});
$('.deleteCourse').on('click', function() {
  const id = $(this).closest('tr').find('input[type=hidden]').val();
  const row = $(this).closest('tr');
  admConfirm('Xóa khóa học này?', () => {
    $.getJSON('/admin/course/courseDelete?id=' + id, json => {
      if (json === true) { row.fadeOut(300, () => row.remove()); admToast('Đã xóa khóa học', 'success'); }
      else admToast('Xóa thất bại', 'error');
    });
  }, '🗑️');
});
function applyFilter() {
  const cat = $('#category_filter').val();
  const lec = $('#lecturer_filter').val();
  location.href = '/admin/course/coursesList?category_filter=' + cat + '&lecture_filter=' + lec;
}
</script>

<%- include('../common/footer') %>

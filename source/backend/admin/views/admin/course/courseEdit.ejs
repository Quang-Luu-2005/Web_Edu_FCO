<% const activePage = 'courses'; const pageTitle = 'Chỉnh sửa khóa học'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Chỉnh sửa khóa học</div>
    <div class="adm-page-subtitle"><a href="/admin/course/coursesList" style="color:#2563eb">← Quay lại danh sách</a></div>
  </div>
</div>

<% if (data.course_info) { %>
<form action="" method="post" id="frmEdit">
  <input type="hidden" name="id"         value="<%= data.course_info._id %>" />
  <input type="hidden" name="lecture_id" value="<%= user._id %>" />

  <!-- Tabs -->
  <div style="display:flex;gap:4px;margin-bottom:16px">
    <button type="button" class="tab-btn active" data-tab="info"     onclick="switchTab('info')">Thông tin</button>
    <button type="button" class="tab-btn"         data-tab="sessions" onclick="switchTab('sessions')">Buổi học</button>
    <button type="button" class="tab-btn"         data-tab="discount" onclick="switchTab('discount')">Mã giảm giá</button>
  </div>

  <style>
  .tab-btn {
    padding:8px 18px;border:1px solid rgba(255,255,255,0.10);border-radius:8px;
    background:transparent;color:#64748b;font-size:13px;font-weight:600;cursor:pointer;
    font-family:inherit;transition:all 0.15s;
  }
  .tab-btn.active { background:#2563eb;border-color:#2563eb;color:#fff; }
  .tab-pane { display:none; }
  .tab-pane.active { display:block; }
  </style>

  <!-- ── Tab: Thông tin ── -->
  <div class="tab-pane active" id="tab-info">
    <div style="display:grid;grid-template-columns:1fr 360px;gap:16px;align-items:start">

      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="adm-card">
          <div class="adm-card-header"><span class="adm-card-title"><i class="fas fa-info-circle" style="color:#2563eb;margin-right:8px"></i>Thông tin cơ bản</span></div>
          <div class="adm-card-body">
            <div class="adm-form-grid">
              <div class="adm-field adm-field-full">
                <label>Tên khóa học</label>
                <input type="text" name="name" value="<%= data.course_info.name %>" />
              </div>
              <div class="adm-field">
                <label>Danh mục</label>
                <select name="category">
                  <% data.categories && data.categories.forEach(cat => { %>
                    <option value="<%= cat._id %>" <%= data.course_info.idCourseTopic && data.course_info.idCourseTopic.toString() === cat._id.toString() ? 'selected' : '' %>>
                      <%= cat.name %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <div class="adm-field">
                <label>Trạng thái</label>
                <select name="status">
                  <option value="1" <%= data.course_info.status ? 'selected' : '' %>>Hiển thị</option>
                  <option value="0" <%= !data.course_info.status ? 'selected' : '' %>>Ẩn</option>
                </select>
              </div>
              <div class="adm-field adm-field-full">
                <label>Mô tả</label>
                <textarea name="description" rows="4"><%= data.course_info.description || '' %></textarea>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px">
        <!-- Poster -->
        <div class="adm-card">
          <div class="adm-card-header"><span class="adm-card-title"><i class="fas fa-image" style="color:#d97706;margin-right:8px"></i>Poster</span></div>
          <div class="adm-card-body">
            <img id="poster-img" src="<%= data.course_info.poster || '' %>"
              style="width:100%;border-radius:8px;object-fit:cover;max-height:160px;background:#0f172a;cursor:pointer;margin-bottom:10px"
              onclick="$('#poster-file').click()" title="Nhấp để đổi ảnh" />
            <input type="file" id="poster-file" style="display:none" accept="image/*" />
            <input type="hidden" name="image" id="poster-url" value="<%= data.course_info.poster || '' %>" />
            <button type="button" class="adm-btn adm-btn-ghost" style="width:100%;height:34px;font-size:12px" onclick="$('#poster-file').click()">
              <i class="fas fa-upload"></i> Đổi poster
            </button>
          </div>
        </div>

        <!-- Giá -->
        <div class="adm-card">
          <div class="adm-card-header"><span class="adm-card-title"><i class="fas fa-tag" style="color:#16a34a;margin-right:8px"></i>Giá</span></div>
          <div class="adm-card-body">
            <div class="adm-field">
              <label>Giá (VNĐ)</label>
              <input type="number" name="tuition" value="<%= data.course_info.tuition || 500000 %>" min="0" step="1000" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Tab: Buổi học ── -->
  <div class="tab-pane" id="tab-sessions">
    <div class="adm-card">
      <div class="adm-card-header">
        <span class="adm-card-title"><i class="fas fa-link" style="color:#2563eb;margin-right:8px"></i>Danh sách buổi học</span>
        <button type="button" class="adm-btn adm-btn-primary adm-btn-sm" onclick="addSession()">
          <i class="fas fa-plus"></i> Thêm buổi
        </button>
      </div>
      <div class="adm-card-body">
        <div id="session-list" style="display:flex;flex-direction:column;gap:10px">
          <% (data.course_info.sessions || []).forEach((s, i) => { %>
          <div class="session-row" id="sr-<%= i %>" style="background:#0f172a;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:14px;display:grid;grid-template-columns:1fr 1fr auto;gap:10px;align-items:start">
            <div class="adm-field">
              <label>Tiêu đề buổi học</label>
              <input type="text" name="sessions[<%= i %>][title]" value="<%= s.title || '' %>" placeholder="VD: Buổi 1 — Kỹ thuật dribble" />
            </div>
            <div class="adm-field">
              <label>Link buổi học</label>
              <input type="url" name="sessions[<%= i %>][link]" value="<%= s.link || '' %>" placeholder="https://meet.google.com/..." />
            </div>
            <button type="button" onclick="document.getElementById('sr-<%= i %>').remove()" style="background:none;border:none;color:#f87171;cursor:pointer;font-size:16px;padding:4px;margin-top:20px"><i class="fas fa-trash"></i></button>
            <div class="adm-field" style="grid-column:1/-1">
              <label>Ghi chú</label>
              <input type="text" name="sessions[<%= i %>][note]" value="<%= s.note || '' %>" placeholder="Nội dung buổi học, yêu cầu chuẩn bị..." />
            </div>
          </div>
          <% }) %>
        </div>
        <% if (!data.course_info.sessions || data.course_info.sessions.length === 0) { %>
        <div id="session-empty" style="text-align:center;padding:32px;color:#475569">
          <i class="fas fa-link" style="font-size:28px;margin-bottom:8px;display:block"></i>
          Chưa có buổi học nào. Nhấn "+ Thêm buổi" để bắt đầu.
        </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- ── Tab: Mã giảm giá ── -->
  <div class="tab-pane" id="tab-discount">
    <div class="adm-card">
      <div class="adm-card-header">
        <span class="adm-card-title"><i class="fas fa-percent" style="color:#16a34a;margin-right:8px"></i>Mã giảm giá</span>
        <button type="button" class="adm-btn adm-btn-primary adm-btn-sm" onclick="addDiscount()">
          <i class="fas fa-plus"></i> Thêm mã
        </button>
      </div>
      <div class="adm-card-body">
        <div style="display:grid;grid-template-columns:2fr 80px 80px 120px auto;gap:8px;padding:0 0 8px;border-bottom:1px solid rgba(255,255,255,0.07);margin-bottom:8px">
          <span style="font-size:10px;font-weight:700;color:#475569;text-transform:uppercase">Mã</span>
          <span style="font-size:10px;font-weight:700;color:#475569;text-transform:uppercase">% Giảm</span>
          <span style="font-size:10px;font-weight:700;color:#475569;text-transform:uppercase">Lượt</span>
          <span style="font-size:10px;font-weight:700;color:#475569;text-transform:uppercase">Hết hạn</span>
          <span></span>
        </div>
        <div id="discount-list" style="display:flex;flex-direction:column;gap:8px">
          <% (data.course_info.discountCodes || []).forEach((dc, i) => { %>
          <div id="dc-<%= i %>" style="display:grid;grid-template-columns:2fr 80px 80px 120px auto;gap:8px;align-items:center">
            <input type="text"   name="discountCodes[<%= i %>][code]"    value="<%= dc.code %>"    placeholder="SALE20"  class="dc-input" />
            <input type="number" name="discountCodes[<%= i %>][percent]" value="<%= dc.percent %>" placeholder="%"       class="dc-input" min="1" max="100" />
            <input type="number" name="discountCodes[<%= i %>][maxUses]" value="<%= dc.maxUses %>" placeholder="0=∞"     class="dc-input" min="0" />
            <input type="date"   name="discountCodes[<%= i %>][expiresAt]" value="<%= dc.expiresAt ? new Date(dc.expiresAt).toISOString().split('T')[0] : '' %>" class="dc-input" />
            <button type="button" onclick="document.getElementById('dc-<%= i %>').remove()" style="background:none;border:none;color:#f87171;cursor:pointer;font-size:14px"><i class="fas fa-times"></i></button>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>

  <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:16px">
    <button type="button" class="adm-btn adm-btn-ghost" onclick="location.href='/admin/course/coursesList'">Huỷ</button>
    <button type="submit" class="adm-btn adm-btn-primary"><i class="fas fa-save"></i> Lưu thay đổi</button>
  </div>
</form>
<% } %>

<style>
.dc-input {
  height:34px;padding:0 10px;background:#0f172a;
  border:1px solid rgba(255,255,255,0.10);border-radius:6px;
  color:#f1f5f9;font-size:12px;outline:none;width:100%;
  box-sizing:border-box;font-family:inherit;
}
.dc-input:focus { border-color:#2563eb; }
</style>

<script>
// ── Tabs ──
function switchTab(name) {
  document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  document.querySelector('[data-tab="' + name + '"]').classList.add('active');
}

// ── Thêm buổi học ──
let sessionCount = <%= (data.course_info.sessions || []).length %>;
function addSession() {
  const empty = document.getElementById('session-empty');
  if (empty) empty.remove();
  const i = sessionCount++;
  const html = `
    <div class="session-row" id="sr-${i}" style="background:#0f172a;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:14px;display:grid;grid-template-columns:1fr 1fr auto;gap:10px;align-items:start">
      <div class="adm-field">
        <label>Tiêu đề buổi học</label>
        <input type="text" name="sessions[${i}][title]" placeholder="VD: Buổi ${i+1} — Kỹ thuật dribble" />
      </div>
      <div class="adm-field">
        <label>Link buổi học</label>
        <input type="url" name="sessions[${i}][link]" placeholder="https://meet.google.com/..." />
      </div>
      <button type="button" onclick="document.getElementById('sr-${i}').remove()" style="background:none;border:none;color:#f87171;cursor:pointer;font-size:16px;padding:4px;margin-top:20px"><i class="fas fa-trash"></i></button>
      <div class="adm-field" style="grid-column:1/-1">
        <label>Ghi chú</label>
        <input type="text" name="sessions[${i}][note]" placeholder="Nội dung buổi học, yêu cầu chuẩn bị..." />
      </div>
    </div>`;
  document.getElementById('session-list').insertAdjacentHTML('beforeend', html);
}

// ── Thêm mã giảm giá ──
let discountCount = <%= (data.course_info.discountCodes || []).length %>;
function addDiscount() {
  const i = discountCount++;
  const html = `
    <div id="dc-${i}" style="display:grid;grid-template-columns:2fr 80px 80px 120px auto;gap:8px;align-items:center">
      <input type="text"   name="discountCodes[${i}][code]"      placeholder="SALE20"  class="dc-input" />
      <input type="number" name="discountCodes[${i}][percent]"   placeholder="%"       class="dc-input" min="1" max="100" />
      <input type="number" name="discountCodes[${i}][maxUses]"   placeholder="0=∞"     class="dc-input" min="0" />
      <input type="date"   name="discountCodes[${i}][expiresAt]"                        class="dc-input" />
      <button type="button" onclick="document.getElementById('dc-${i}').remove()" style="background:none;border:none;color:#f87171;cursor:pointer;font-size:14px"><i class="fas fa-times"></i></button>
    </div>`;
  document.getElementById('discount-list').insertAdjacentHTML('beforeend', html);
}

// ── Upload poster ──
$('#poster-file').on('change', function() {
  const fd = new FormData();
  const files = this.files;
  const id = $("input[name='id']").val();
  if (!files.length) return;
  fd.append('file', files[0]);
  $.ajax({
    url: '/admin/upload?fileType=image&id=' + id + '&folder=/poster/&folder_cloud=webctt2/course_image',
    type: 'post', data: fd, contentType: false, processData: false,
    success: res => {
      if (res) {
        $('#poster-img').attr('src', res + '?t=' + Date.now());
        $('#poster-url').val(res);
        admToast('Poster đã cập nhật', 'success');
      }
    }
  });
});
</script>

<%- include('../common/footer') %>

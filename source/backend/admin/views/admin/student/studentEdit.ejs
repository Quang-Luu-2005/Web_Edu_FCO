<% const activePage = 'students'; const pageTitle = 'Chỉnh sửa học viên'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Chỉnh sửa học viên</div>
    <div class="adm-page-subtitle"><a href="/admin/student/studentsList" style="color:#2563eb">← Quay lại danh sách</a></div>
  </div>
</div>

<% if (data.student_info) { %>
<form action="" method="post" id="frmStudent">
  <input type="hidden" name="id" value="<%= data.student_info._id %>" />
  <div class="adm-card" style="max-width:680px">
    <div class="adm-card-header">
      <span class="adm-card-title"><i class="fas fa-user-edit" style="color:#2563eb;margin-right:8px"></i>Thông tin học viên</span>
    </div>
    <div class="adm-card-body">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,0.07)">
        <img src="<%= data.student_info.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>"
          style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:2px solid #2563eb" />
        <div>
          <div style="font-size:15px;font-weight:700;color:#f1f5f9"><%= data.student_info.name || data.student_info.username %></div>
          <div style="font-size:13px;color:#64748b"><%= data.student_info.email %></div>
        </div>
      </div>
      <div class="adm-form-grid">
        <div class="adm-field">
          <label>Tên hiển thị</label>
          <input type="text" name="name" value="<%= data.student_info.name || '' %>" />
        </div>
        <div class="adm-field">
          <label>Giới tính</label>
          <select name="gender">
            <option value="male"   <%= data.student_info.gender === 'male'   ? 'selected' : '' %>>Nam</option>
            <option value="female" <%= data.student_info.gender === 'female' ? 'selected' : '' %>>Nữ</option>
            <option value="other"  <%= !['male','female'].includes(data.student_info.gender) ? 'selected' : '' %>>Khác</option>
          </select>
        </div>
        <div class="adm-field">
          <label>Trạng thái</label>
          <select name="status">
            <option value="1" <%= data.student_info.status ? 'selected' : '' %>>Hoạt động</option>
            <option value="0" <%= !data.student_info.status ? 'selected' : '' %>>Bị khóa</option>
          </select>
        </div>
        <div class="adm-field">
          <label>Mật khẩu mới <span style="color:#64748b;font-weight:400;text-transform:none">(để trống nếu không đổi)</span></label>
          <input type="password" name="password" placeholder="••••••••" autocomplete="new-password" />
        </div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:24px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.07)">
        <button type="button" class="adm-btn adm-btn-ghost" onclick="location.href='/admin/student/studentsList'">Huỷ</button>
        <button type="submit" class="adm-btn adm-btn-primary"><i class="fas fa-save"></i> Lưu thay đổi</button>
      </div>
    </div>
  </div>
</form>
<% } %>

<%- include('../common/footer') %>

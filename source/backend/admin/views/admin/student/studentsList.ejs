<% const activePage = 'students'; const pageTitle = 'Học viên'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Danh sách học viên</div>
    <div class="adm-page-subtitle"><%= data.students ? data.students.length : 0 %> người dùng</div>
  </div>
  <button class="adm-btn adm-btn-primary" onclick="location.href='/admin/student/studentAdd'">
    <i class="fas fa-plus"></i> Thêm học viên
  </button>
</div>

<div class="adm-card">
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Học viên</th>
          <th>Email</th>
          <th>Giới tính</th>
          <th>Trạng thái</th>
          <th>Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (data.students && data.students.length > 0) { %>
          <% data.students.forEach(s => { %>
          <tr>
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <img class="adm-avatar" src="<%= s.avatar || 'https://i.ibb.co/NnbNMtSw/default-avatar.png' %>" alt="avatar" />
                <span style="font-weight:600;color:#f1f5f9"><%= s.name || s.username || '—' %></span>
              </div>
            </td>
            <td style="color:#94a3b8"><%= s.email %></td>
            <td><%= s.gender === 'male' ? 'Nam' : s.gender === 'female' ? 'Nữ' : 'Khác' %></td>
            <td>
              <span class="adm-badge <%= s.status ? 'adm-badge-green' : 'adm-badge-red' %>">
                <%= s.status ? 'Hoạt động' : 'Bị khóa' %>
              </span>
            </td>
            <td>
              <div style="display:flex;gap:6px">
                <input type="hidden" value="<%= s._id %>">
                <button class="adm-btn adm-btn-primary adm-btn-sm adm-btn-icon viewStudent" title="Chỉnh sửa">
                  <i class="fas fa-pen"></i>
                </button>
                <button class="adm-btn adm-btn-danger adm-btn-sm adm-btn-icon deleteStudent" title="Xóa">
                  <i class="fas fa-trash"></i>
                </button>
              </div>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5">
            <div class="adm-empty"><i class="fas fa-users"></i><p>Chưa có học viên nào</p></div>
          </td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
$('.viewStudent').on('click', function() {
  const id = $(this).closest('tr').find('input[type=hidden]').val();
  location.href = '/admin/student/studentEdit?id=' + id;
});
$('.deleteStudent').on('click', function() {
  const id = $(this).closest('tr').find('input[type=hidden]').val();
  const row = $(this).closest('tr');
  admConfirm('Xóa học viên này?', () => {
    $.getJSON('/admin/student/studentDelete?id=' + id, json => {
      if (json === true) { row.fadeOut(300, () => row.remove()); admToast('Đã xóa học viên', 'success'); }
      else admToast('Xóa thất bại', 'error');
    });
  }, '🗑️');
});
</script>

<%- include('../common/footer') %>

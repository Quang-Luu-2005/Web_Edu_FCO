<% const activePage = 'verifications'; const pageTitle = 'Xác nhận học viên'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div>
    <div class="adm-page-title">Yêu cầu xác nhận học viên</div>
    <div class="adm-page-subtitle"><%= data.requests.length %> yêu cầu đang chờ</div>
  </div>
</div>

<% if (data.requests.length === 0) { %>
  <div class="adm-card">
    <div class="adm-empty">
      <i class="fas fa-check-circle" style="color:#16a34a"></i>
      <p>Không có yêu cầu nào đang chờ xử lý 🎉</p>
    </div>
  </div>
<% } else { %>
  <div style="display:flex;flex-direction:column;gap:12px">
    <% data.requests.forEach(r => { %>
    <div class="adm-card" id="vr-<%= r._id %>" style="overflow:visible">
      <div class="adm-card-body" style="display:flex;gap:16px;align-items:flex-start">
        <img src="<%= r.userId.avatar %>" style="width:48px;height:48px;border-radius:50%;object-fit:cover;border:2px solid #2563eb;flex:0 0 auto" />
        <div style="flex:1;min-width:0">
          <div style="font-size:15px;font-weight:700;color:#f1f5f9;margin-bottom:2px"><%= r.userId.name || r.userId.username %></div>
          <div style="font-size:13px;color:#64748b;margin-bottom:8px"><%= r.userId.email %></div>
          <% if (r.note) { %>
          <div style="font-size:13px;color:#94a3b8;margin-bottom:10px;font-style:italic">"<%= r.note %>"</div>
          <% } %>
          <a href="<%= r.proofImageUrl %>" target="_blank">
            <img src="<%= r.proofImageUrl %>" style="max-width:280px;border-radius:8px;border:1px solid rgba(255,255,255,0.1);transition:transform 0.15s" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform=''" />
          </a>
          <div style="font-size:12px;color:#475569;margin-top:8px">
            <i class="fas fa-clock"></i> <%= new Date(r.createdAt).toLocaleString('vi-VN') %>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;gap:8px;flex:0 0 auto">
          <button class="adm-btn adm-btn-success adm-btn-sm" onclick="handleRequest('<%= r._id %>', 'approve')">
            <i class="fas fa-check"></i> Duyệt
          </button>
          <button class="adm-btn adm-btn-danger adm-btn-sm" onclick="handleRequest('<%= r._id %>', 'reject')">
            <i class="fas fa-times"></i> Từ chối
          </button>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
<% } %>

<script>
async function handleRequest(id, action) {
  const note = action === 'reject' ? (prompt('Lý do từ chối (tuỳ chọn):') || '') : '';
  const res  = await fetch('/admin/verifications/' + id + '/' + action, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ adminNote: note })
  });
  const json = await res.json();
  if (json.ok) {
    const el = document.getElementById('vr-' + id);
    el.style.opacity = '0.4';
    el.style.pointerEvents = 'none';
    admToast(action === 'approve' ? '✓ Đã duyệt yêu cầu' : '✗ Đã từ chối yêu cầu', action === 'approve' ? 'success' : 'error');
  }
}
</script>

<%- include('../common/footer') %>

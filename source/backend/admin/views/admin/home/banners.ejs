<% const activePage = 'banners'; const pageTitle = 'Banner trang chủ'; %>
<%- include('../common/header', {user, activePage, pageTitle}) %>

<div class="adm-page-header">
  <div class="adm-page-title">Banner trang chủ</div>
  <button class="adm-btn adm-btn-primary" onclick="$('#frmHomeBanners').submit()">
    <i class="fas fa-save"></i> Lưu banner
  </button>
</div>

<form action="/admin/home/banners" method="post" id="frmHomeBanners">
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px">
    <% for (let i = 0; i < 3; i++) { %>
    <div class="adm-card">
      <div class="adm-card-header">
        <span class="adm-card-title">Banner <%= i + 1 %></span>
      </div>
      <div class="adm-card-body" style="padding:16px">
        <img id="banner-preview-<%= i+1 %>" src="<%= data.banners[i] || '' %>"
          style="width:100%;height:160px;object-fit:cover;border-radius:8px;background:#0f172a;margin-bottom:12px;display:block" />
        <input type="hidden" name="banner<%= i+1 %>" id="banner-<%= i+1 %>" value="<%= data.banners[i] || '' %>" />
        <div class="adm-field" style="margin-bottom:10px">
          <label>Chọn ảnh</label>
          <input type="file" id="banner-file-<%= i+1 %>" accept="image/*" style="height:auto;padding:8px" />
        </div>
        <button type="button" class="adm-btn adm-btn-ghost" style="width:100%" onclick="uploadBanner(<%= i+1 %>)">
          <i class="fas fa-cloud-upload-alt"></i> Upload ảnh
        </button>
      </div>
    </div>
    <% } %>
  </div>
</form>

<script>
function uploadBanner(slot) {
  const input = document.getElementById('banner-file-' + slot);
  if (!input.files.length) { admToast('Vui lòng chọn ảnh', 'error'); return; }
  const fd = new FormData();
  fd.append('file', input.files[0]);
  $.ajax({
    url: '/admin/upload?fileType=image&id=home-banner-' + slot + '&folder=/home-banner/&folder_cloud=webctt2/home-banner',
    type: 'post', data: fd, contentType: false, processData: false,
    success: res => {
      if (res) {
        $('#banner-preview-' + slot).attr('src', res + '?t=' + Date.now());
        $('#banner-' + slot).val(res);
        admToast('Upload thành công', 'success');
      } else admToast('Upload thất bại', 'error');
    }
  });
}
</script>

<%- include('../common/footer') %>

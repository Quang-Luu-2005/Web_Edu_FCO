<div class="toolbar-actions admin-toolbar-actions">
    <a class="btn btn-primary toolbar-btn" href="/" role="button">
        <i class="fa fa-home" aria-hidden="true"></i>
        Home
    </a>
    <% if (!isAuthenticated) { %>
    <a class="btn btn-danger toolbar-btn" href="/users/login">Đăng nhập</a>
    <% } %>
    <% if (isAuthenticated) { %>
    <a class="btn btn-info toolbar-btn" href="/users/account">Tài khoản</a>
    <a class="btn btn-secondary toolbar-btn" href="/users/logout">Đăng xuất</a>
    <a class="btn btn-light toolbar-btn" href="/users/my-wish-list">
        <i class="fa fa-heart" aria-hidden="true" style="color:red;"></i>
        Yêu thích
    </a>
    <a class="btn btn-light toolbar-btn" href="/my-courses">
        <i class="fas fa-folder-open" style="color: darkorange;"></i>
        Khóa học của tôi
    </a>
    <% } %>
</div>

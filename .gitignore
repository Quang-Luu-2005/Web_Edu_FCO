# ==================================================
# Project gitignore
# Keep source code, package manifests, lockfiles, and docs tracked.
# Ignore local config, secrets, dependencies, generated files, and runtime uploads.
# ==================================================

# Environment / secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Build / generated output
dist/
build/
coverage/
.cache/
.parcel-cache/
.next/
.nuxt/
out/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.parcel-cache/
**/.next/
**/.nuxt/
**/out/

# Logs / debug files
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime temp/cache
.tmp/
tmp/
temp/
.cache/
**/.tmp/
**/tmp/
**/temp/

# Local editor / assistant / machine config
.vscode/
**/.vscode/
.idea/
**/.idea/
.kiro/
.claude/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Backend runtime/static generated assets
# Source/backend already has its own .gitignore with detailed static asset rules.
source/backend/public/avatar/*/
source/backend/admin/public/avatar/5*/
source/backend/admin/public/avatar/6*/
source/backend/admin/public/poster/5*/
source/backend/admin/public/poster/beginer*/
source/backend/admin/public/poster/game*/
source/backend/admin/public/poster/graph*/
source/backend/admin/public/poster/tut*/
source/backend/admin/public/image/category/5*/
source/backend/admin/public/image/category/undefined/
source/backend/admin/public/image/lecturer/5*/
